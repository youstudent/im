{
  "name": "desktop-client",
  "version": "1.10.0",
  "description": "基于 Electron + Vue 3 + Vite 的桌面应用开发框架",
  "author": "WorkBuddy",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n \"VITE,ELECTRON\" -c \"cyan,magenta\" \"vite\" \"wait-on tcp:5173 && cross-env IS_DEV=true node electron/dev-launch.js\"",
    "build": "vite build && electron-builder",
    "build:renderer": "vite build",
    "preview": "vite preview",
    "pack": "npm run build:renderer && electron-builder --dir",
    "dist": "npm run build",
    "build:win": "vite build && electron-builder --win",
    "build:win:x64": "vite build && electron-builder --win --x64",
    "build:win:x86": "vite build && electron-builder --win --ia32",
    "build:win:arm64": "vite build && electron-builder --win --arm64",
    "build:mac": "vite build && electron-builder --mac",
    "build:mac:intel": "vite build && electron-builder --mac --x64",
    "build:mac:apple": "vite build && electron-builder --mac --arm64",
    "build:mac:universal": "vite build && electron-builder --mac --universal",
    "build:linux": "vite build && electron-builder --linux",
    "build:linux:deb": "vite build && electron-builder --linux deb",
    "build:linux:rpm": "vite build && electron-builder --linux rpm",
    "pack:win": "npm run build:renderer && electron-builder --win --dir",
    "pack:mac": "npm run build:renderer && electron-builder --mac --dir",
    "pack:linux": "npm run build:renderer && electron-builder --linux --dir",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "12.11.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.workbuddy.desktopclient",
    "productName": "检车家IM",
    "copyright": "Copyright © 2026 WorkBuddy",
    "npmRebuild": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asar": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "检车家IM",
      "uninstallDisplayName": "检车家IM",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tool"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Development"
    }
  }
}
