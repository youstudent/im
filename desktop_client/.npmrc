# Electron 二进制下载镜像：避免直连 GitHub Releases 超时/断连（国内网络）
electron_mirror=https://npmmirror.com/mirrors/electron/
# better-sqlite3 预编译二进制镜像：优先下载现成 .node，避免本机 C++ 编译
better_sqlite3_binary_host_mirror=https://registry.npmmirror.com/-/binary/better-sqlite3
# SQLCipher 全库加密：better-sqlite3-multiple-ciphers 的 prebuild 从 GitHub Releases 下载，
# 空代理覆盖用户级 .npmrc 中不可用的本地代理（127.0.0.1:7890），保持本地/CI 可重复安装
proxy=
https-proxy=
