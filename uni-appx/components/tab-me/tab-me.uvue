<template>
	<view class="page">
		<!-- 顶部导航 -->
		<view class="nav-bar">
			<text class="nav-title">我</text>
		</view>

		<!-- 内容区 -->
		<scroll-view class="content" scroll-y>
			<!-- 个人信息卡片 -->
			<view class="profile-card" @click="onProfileClick">
				<view class="profile-avatar">
					<text class="profile-avatar-text">小</text>
				</view>
				<view class="profile-info">
					<text class="profile-name">小 Work</text>
					<text class="profile-id">微信号：xiaowork</text>
				</view>
				<view class="arrow"></view>
			</view>

			<!-- 菜单列表 -->
			<view class="menu-list">
				<view
					class="menu-item"
					v-for="(item, index) in menuList"
					:key="item.key"
					:class="{ 'has-gap': item.gap }"
					@click="onItemClick(item)"
				>
					<view class="menu-icon" :class="`icon-${item.key}`">
						<text v-if="item.key === 'favorites'" class="icon-text">★</text>
						<text v-if="item.key === 'settings'" class="icon-text">⚙</text>
						<view class="i1"></view>
						<view class="i2"></view>
					</view>
					<text class="menu-name">{{ item.name }}</text>
					<view class="arrow"></view>
					<view class="gap-line"></view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'

	type MenuItem = {
		key: string
		name: string
		gap: boolean
	}

	const menuList = ref<MenuItem[]>([
		{ key: 'services', name: '服务', gap: true },
		{ key: 'favorites', name: '收藏', gap: false },
		{ key: 'moments', name: '朋友圈', gap: false },
		{ key: 'cards', name: '卡包', gap: false },
		{ key: 'stickers', name: '表情', gap: true },
		{ key: 'subscription', name: '订阅号', gap: false },
		{ key: 'settings', name: '设置', gap: false }
	])

	const onProfileClick = () => {
		uni.navigateTo({ url: '/pages/profile-edit/profile-edit' })
	}

	const onItemClick = (item: MenuItem) => {
		if (item.key === 'settings') {
			uni.navigateTo({ url: '/pages/settings/settings' })
			return
		}
		if (item.key === 'moments') {
			uni.navigateTo({ url: '/pages/moments/moments' })
			return
		}
		if (item.key === 'favorites') {
			uni.navigateTo({ url: '/pages/favorites/favorites' })
			return
		}
		if (item.key === 'subscription') {
			uni.navigateTo({ url: '/pages/subscription/subscription' })
			return
		}
		if (item.key === 'services') {
			uni.navigateTo({ url: '/pages/pay-home/pay-home' })
			return
		}
		if (item.key === 'cards') {
			uni.navigateTo({ url: '/pages/card-bag/card-bag' })
			return
		}
		uni.showToast({ title: item.name, icon: 'none' })
	}
</script>

