<template>
	<view class="page">
		<!-- 顶部导航 -->
		<view class="nav-bar">
			<text class="nav-title">发现</text>
		</view>

		<!-- 内容区 -->
		<scroll-view class="content" scroll-y>
			<view class="menu-list">
				<view
					class="menu-item"
					v-for="(item, index) in menuList"
					:key="item.key"
					:class="{ 'has-gap': item.gap }"
					@click="onItemClick(item)"
				>
					<view class="menu-icon" :class="`icon-${item.key}`">
						<view class="i1"></view>
						<view class="i2"></view>
					</view>
					<text class="menu-name">{{ item.name }}</text>
					<view class="arrow"></view>
					<view class="gap-line"></view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'

	type MenuItem = {
		key: string
		name: string
		gap: boolean
	}

	const menuList = ref<MenuItem[]>([
		{ key: 'moments', name: '朋友圈', gap: true },
		{ key: 'scan', name: '扫一扫', gap: false },
		{ key: 'shake', name: '摇一摇', gap: true },
		{ key: 'look', name: '看一看', gap: false },
		{ key: 'search', name: '搜一搜', gap: false },
		{ key: 'mini-apps', name: '小程序', gap: false }
	])

	const onItemClick = (item: MenuItem) => {
		if (item.key === 'moments') {
			uni.navigateTo({ url: '/pages/moments/moments' })
			return
		}
		if (item.key === 'scan') {
			uni.navigateTo({ url: '/pages/scan/scan' })
			return
		}
		uni.showToast({ title: item.name, icon: 'none' })
	}
</script>

<style scoped>
