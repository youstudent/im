		transform: translate(-50%, -50%);
		width: 2px;
		height: 18px;
	}

	/* 内容区 */
	.content {
		flex: 1;
		background-color: #F5F5F5;
	}

	/* 搜索栏 */
	.search-wrap {
		background-color: #FFFFFF;
		padding: 8px 12px;
		border-bottom: 1px solid #E5E5E5;
	}

	.search-bar {
		display: flex;
