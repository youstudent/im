<template>
	<view class="page">
		<!-- 顶部导航 -->
		<view class="nav-bar">
			<view class="nav-left"></view>
			<text class="nav-title">通讯录</text>
			<view class="nav-right" @click="onAdd">
				<view class="icon-plus">
					<view class="nav-plus-i1"></view>
					<view class="nav-plus-i2"></view>
				</view>
			</view>
		</view>

		<!-- 内容区 -->
		<scroll-view class="content" scroll-y :scroll-into-view="scrollInto">
			<!-- 搜索栏 -->
			<view class="search-wrap">
				<view class="search-bar" @click="onSearch">
					<view class="search-icon">
						<view class="search-icon-i2"></view>
					</view>
					<text class="search-text">搜索</text>
				</view>
			</view>

			<!-- 功能入口 -->
			<view class="func-list">
				<view
					class="func-item"
					v-for="item in funcList"
					:key="item.key"
					@click="onFuncClick(item)"
				>
					<view class="func-icon" :class="`icon-${item.key}`">
						<view class="i1" :class="`fi-${item.key}-i1`"></view>
						<view class="i2" :class="`fi-${item.key}-i2`"></view>
						<view v-if="item.key === 'new-friend'" class="fi-new-friend-plus">
							<view class="fi-new-friend-plus-i2"></view>
						</view>
						<view v-if="item.key === 'group'" class="fi-group-plus"></view>
					</view>
					<text class="func-name">{{ item.name }}</text>
				</view>
			</view>

			<!-- 联系人分组 -->
			<view class="contact-groups">
				<view
					class="group"
					v-for="group in contactGroups"
					:key="group.letter"
				>
					<view class="group-header" :id="'group-' + group.letter">{{ group.letter }}</view>
					<view class="group-items">
						<view
							class="contact-item"
							v-for="contact in group.list"
							:key="contact.id"
							@click="onContactClick(contact)"
						>
							<view
								class="avatar"
								:style="{ backgroundColor: contact.avatarColor }"
							>
								<text class="avatar-text">{{ contact.avatarText }}</text>
							</view>
							<text class="contact-name">{{ contact.name }}</text>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- 字母索引浮层 -->
		<alpha-index @select="onAlphaSelect"></alpha-index>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'

	type FuncItem = {
		key: string
		name: string
	}

	type Contact = {
		id: string
		name: string
		avatarText: string
		avatarColor: string
	}

	type ContactGroup = {
		letter: string
		list: Contact[]
	}

	const funcList = ref<FuncItem[]>([
		{ key: 'new-friend', name: '新的朋友' },
		{ key: 'group', name: '群聊' },
		{ key: 'tag', name: '标签' },
		{ key: 'official', name: '公众号' }
	])

	const contactGroups = ref<ContactGroup[]>([
		{
			letter: 'C',
			list: [
				{ id: 'c1', name: '陈晨', avatarText: '陈', avatarColor: '#07C160' }
			]
		},
		{
			letter: 'L',
			list: [
				{ id: 'l1', name: '林晚', avatarText: '林', avatarColor: '#FF9500' },
				{ id: 'l2', name: '李娜', avatarText: '李', avatarColor: '#FF4D6A' }
			]
		},
		{
			letter: 'W',
			list: [
				{ id: 'w1', name: '王强', avatarText: '王', avatarColor: '#9B59B6' }
			]
		},
		{
			letter: 'Z',
			list: [
				{ id: 'z1', name: '张可', avatarText: '张', avatarColor: '#007AFF' }
			]
		}
	])

	const scrollInto = ref<string | null>(null)

	const onSearch = () => {
		uni.navigateTo({ url: '/pages/global-search/global-search', animationType: 'slide-in-right', animationDuration: 300 })
	}

	const onAlphaSelect = (letter: string) => {
		scrollInto.value = 'group-' + letter
		// 用后重置为 null，避免 scroll-into-view 持续绑定导致 App 端 scroll-view 滚动异常
		setTimeout(() => {
			scrollInto.value = null
		}, 400)
	}

	const onAdd = () => {
		uni.showToast({ title: '添加朋友', icon: 'none' })
	}

	const onFuncClick = (item: FuncItem) => {
		if (item.key === 'new-friend') {
			uni.navigateTo({ url: '/pages/new-friends/new-friends', animationType: 'slide-in-right', animationDuration: 300 })
			return
		}
		if (item.key === 'group') {
			uni.navigateTo({ url: '/pages/group-list/group-list', animationType: 'slide-in-right', animationDuration: 300 })
			return
		}
		uni.showToast({ title: item.name, icon: 'none' })
	}

	const onContactClick = (contact: Contact) => {
		uni.navigateTo({ url: '/pages/contact-detail/contact-detail', animationType: 'slide-in-right', animationDuration: 300 })
	}
</script>

<style scoped>
