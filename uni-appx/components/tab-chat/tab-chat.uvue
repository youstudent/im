<template>
	<view class="page">
		<!-- 顶部导航 -->
		<view class="nav-bar">
			<view class="nav-left"></view>
			<text class="nav-title">chat</text>
			<view class="nav-right" @click="onAdd">
				<view class="icon-plus">
					<view class="i1"></view>
					<view class="i2"></view>
				</view>
			</view>
		</view>

		<!-- 搜索栏 -->
		<view class="search-wrap">
			<view class="search-bar">
				<view class="search-icon">
					<view class="i2"></view>
				</view>
				<text class="search-text">搜索</text>
			</view>
		</view>

		<!-- 会话列表 -->
		<scroll-view class="list-scroll" scroll-y>
			<view class="chat-list">
				<view
					class="chat-item"
					v-for="item in chatList"
					:key="item.id"
					hover-class="item-hover"
					@click="onItemClick(item)"
				>
					<view class="avatar-wrap">
						<view
							class="avatar"
							:style="{ backgroundColor: item.avatarColor }"
						>
							<text class="avatar-text">{{ item.avatarText }}</text>
						</view>
						<view v-if="item.unread > 0" class="badge">
							<text class="badge-text">{{ item.unread }}</text>
						</view>
					</view>

					<view class="content">
						<view class="content-top">
							<text class="name">{{ item.name }}</text>
							<text class="time">{{ item.time }}</text>
						</view>
						<text class="message">{{ item.message }}</text>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'

	type ChatItem = {
		id: string
		name: string
		avatarText: string
		avatarColor: string
		message: string
		time: string
		unread: number
	}

	const chatList = ref<ChatItem[]>([
		{
			id: '1',
			name: '林晚',
			avatarText: '林',
			avatarColor: '#FF9500',
			message: '在吗？明天一起吃饭呀',
			time: '14:30',
			unread: 2
		},
		{
			id: '2',
			name: '产品交流群',
			avatarText: '群',
			avatarColor: '#07C160',
			message: '[图片]',
			time: '14:22',
			unread: 9
		},
		{
			id: '3',
			name: '张可',
			avatarText: '张',
			avatarColor: '#007AFF',
			message: '好的，收到～',
			time: '昨天',
			unread: 0
		},
		{
			id: '4',
			name: '文件传输助手',
			avatarText: '文',
			avatarColor: '#07C160',
			message: '设计稿v2.pdf',
			time: '昨天',
			unread: 0
		},
		{
			id: '5',
			name: '李娜',
			avatarText: '李',
			avatarColor: '#FF4D6A',
			message: '周末爬山吗？',
			time: '周二',
			unread: 0
		},
		{
			id: '6',
			name: '订阅号',
			avatarText: '订',
			avatarColor: '#FF9500',
			message: '科技早报：AI 新进展',
			time: '周一',
			unread: 0
		}
	])

	const onAdd = () => {
		uni.showToast({ title: '发起聊天', icon: 'none' })
	}

	const onItemClick = (item: ChatItem) => {
		// 统一右滑推入转场（微信风格），与各会话页 navigateBack 动画对应
		if (item.id === '2') {
			uni.navigateTo({ url: '/pages/group-chat/group-chat', animationType: 'slide-in-right', animationDuration: 300 })
			return
		}
		if (item.id === '4') {
			uni.navigateTo({ url: '/pages/chat-media/chat-media', animationType: 'slide-in-right', animationDuration: 300 })
			return
		}
		if (item.id === '6') {
			uni.navigateTo({ url: '/pages/subscription/subscription', animationType: 'slide-in-right', animationDuration: 300 })
			return
		}
		uni.navigateTo({ url: '/pages/chat/chat', animationType: 'slide-in-right', animationDuration: 300 })
	}

</script>

