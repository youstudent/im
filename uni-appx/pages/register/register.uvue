<template>
	<view class="page">
		<!-- 状态栏占位 -->
		<view class="status-bar"></view>

		<!-- 顶部导航 -->
		<view class="nav-bar">
			<view class="back-icon" @click="goBack"></view>
			<text class="nav-title">注册</text>
		</view>

		<view class="container">
			<!-- Logo 区域 -->
			<view class="logo-wrap">
				<view class="logo">
					<view class="face">
						<view class="eyes">
							<view class="eye"></view>
							<view class="eye"></view>
						</view>
						<view class="mouth"></view>
					</view>
				</view>
				<text class="app-name">WorkChat</text>
			</view>

			<!-- 表单区域 -->
			<view class="form">
				<view class="input-row">
					<text class="prefix">+86</text>
					<input
						class="input" adjust-position="false"
						type="number"
						v-model="phone"
						placeholder="请输入手机号"
						placeholder-class="placeholder"
						maxlength="11"
					/>
				</view>

				<view class="input-row">
					<input
						class="input" adjust-position="false"
						type="number"
						v-model="code"
						placeholder="请输入验证码"
						placeholder-class="placeholder"
						maxlength="6"
					/>
					<text
						class="code-link"
						:class="{ disabled: counting }"
						@click="onGetCode"
					>
						{{ codeText }}
					</text>
				</view>

				<view class="input-row">
					<input
						class="input" adjust-position="false"
						type="password"
						v-model="password"
						placeholder="请设置密码"
						placeholder-class="placeholder"
					/>
				</view>

				<view class="input-row">
					<input
						class="input" adjust-position="false"
						type="password"
						v-model="confirmPassword"
						placeholder="请再次输入密码"
						placeholder-class="placeholder"
					/>
				</view>

				<!-- 协议勾选：整行可点击切换 -->
				<view class="agreement" @click="toggleAgreed">
					<view class="checkbox" :class="{ checked: agreed }">
						<text v-if="agreed" class="check-icon">✓</text>
					</view>
					<text class="agreement-text">已阅读并同意</text>
					<text class="agreement-link" @click.stop="openAgreement">《软件许可及服务协议》</text>
					<text class="agreement-text">和</text>
					<text class="agreement-link" @click.stop="openPrivacy">《隐私政策》</text>
				</view>

				<button class="btn-primary" @click="onRegister">注册</button>

				<view class="switch-row">
					<text class="switch-label">已有账号？</text>
					<text class="link" @click="goLogin">登录</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'

	const phone = ref<string>('')
	const code = ref<string>('')
	const password = ref<string>('')
	const confirmPassword = ref<string>('')
	const agreed = ref<boolean>(true)
	const counting = ref<boolean>(false)
	const countDown = ref<number>(60)

	const toggleAgreed = () => {
		agreed.value = !agreed.value
	}

	let timer : number | null = null

	const codeText = computed<string>(() => {
		return counting.value ? `${countDown.value}s后重发` : '获取验证码'
	})

	const goBack = () => {
		uni.navigateBack()
	}

	const goLogin = () => {
		uni.navigateTo({ url: '/pages/login/login' })
	}

	const onGetCode = () => {
		if (counting.value) return
		if (phone.value.trim().length === 0) {
			uni.showToast({ title: '请输入手机号', icon: 'none' })
			return
		}
		uni.showToast({ title: '验证码已发送', icon: 'none' })
		counting.value = true
		countDown.value = 60
		timer = setInterval(() => {
			countDown.value--
			if (countDown.value <= 0) {
				counting.value = false
				const currentTimer = timer
				if (currentTimer != null) {
					clearInterval(currentTimer)
					timer = null
				}
			}
		}, 1000)
	}

	const onRegister = () => {
		if (phone.value.trim().length === 0) {
			uni.showToast({ title: '请输入手机号', icon: 'none' })
			return
		}
		if (code.value.trim().length === 0) {
			uni.showToast({ title: '请输入验证码', icon: 'none' })
			return
		}
		if (password.value.length === 0) {
			uni.showToast({ title: '请设置密码', icon: 'none' })
			return
		}
		if (password.value !== confirmPassword.value) {
			uni.showToast({ title: '两次密码输入不一致', icon: 'none' })
			return
		}
		if (!agreed.value) {
			uni.showToast({ title: '请先同意协议', icon: 'none' })
			return
		}
		// 注册成功，自动登录并进入应用首页
	uni.reLaunch({ url: '/pages/chat-list/chat-list' })
	}

	const openAgreement = () => {
		uni.showToast({ title: '打开服务协议', icon: 'none' })
	}

	const openPrivacy = () => {
		uni.showToast({ title: '打开隐私政策', icon: 'none' })
	}
</script>

<style>
	.page {
		height: 100%;
		background-color: #F7F7F7;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

	/* 顶部导航 */
	.nav-bar {
		display: flex;
		flex-direction: row;
		align-items: center;
		height: 44px;
		padding: 0 8px;
		background-color: #F8F8F8;
		position: relative;
	}

	.back-icon {
		width: 11px;
		height: 11px;
		border-left: 2px solid #333;
		border-bottom: 2px solid #333;
		transform: rotate(45deg);
		margin-left: 12px;
		margin-right: 6px;
	}

	.nav-title {
		font-size: 17px;
		color: #000;
		font-weight: 500;
		line-height: 44px;
	}

	/* Logo 区域 */
	.logo-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-top: 48px;
		margin-bottom: 24px;
	}

	.logo {
		width: 90px;
		height: 90px;
		background-color: #07C160;
		border-radius: 24px;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.face {
		position: relative;
		width: 54px;
		height: 46px;
	}

	.eyes {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		width: 38px;
		margin: 0 auto;
	}

	.eye {
		width: 8px;
		height: 8px;
		background-color: #fff;
		border-radius: 50%;
	}

	.mouth {
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 36px;
		height: 18px;
		border-bottom: 4px solid #fff;
		border-radius: 0 0 18px 18px;
	}

	.app-name {
		margin-top: 16px;
		font-size: 24px;
		color: #07C160;
		font-weight: 600;
	}

	.container {
		padding: 0 32px;
	}

	/* 表单区域 */
	.form {
		margin-top: 4px;
		width: 100%;
	}

	.input-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		width: 100%;
		height: 52px;
		background-color: #fff;
		border-radius: 12px;
		padding: 0 16px;
		margin-bottom: 16px;
		box-sizing: border-box;
		border: 1px solid #F0F0F0;
	}

	.prefix {
		font-size: 16px;
		color: #333;
		margin-right: 12px;
		font-weight: 500;
	}

	.input {
		flex: 1;
		height: 100%;
		font-size: 16px;
		color: #333;
		border: none;
		background-color: transparent;
	}

	.placeholder {
		color: #BBBBBB;
		font-size: 16px;
	}

	.link {
		font-size: 14px;
		color: #07C160;
	}

	.code-link {
		font-size: 14px;
		color: #07C160;
		margin-left: 8px;
	}

	.code-link.disabled {
		color: #999;
	}

	/* 协议勾选 */
	.agreement {
		display: flex;
		flex-direction: row;
		align-items: center;
		flex-wrap: wrap;
		margin-bottom: 24px;
		padding: 8px 8px;
	}

	.checkbox {
		width: 16px;
		height: 16px;
		border: 1px solid #999;
		border-radius: 3px;
		margin-right: 6px;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.checkbox.checked {
		background-color: #07C160;
		border-color: #07C160;
	}

	.check-icon {
		color: #fff;
		font-size: 11px;
		font-weight: bold;
		line-height: 1;
	}

	.agreement-text {
		font-size: 12px;
		color: #999;
	}

	.agreement-link {
		font-size: 12px;
		color: #07C160;
	}

	.btn-primary {
		width: 100%;
		height: 50px;
		line-height: 50px;
		background-color: #07C160;
		color: #fff;
		font-size: 18px;
		border-radius: 10px;
		text-align: center;
		border: none;
		padding: 0;
	}

	.btn-primary::after {
		border: none;
	}

	.switch-row {
		display: flex;
		flex-direction: row;
		justify-content: center;
		margin-top: 20px;
	}

	.switch-label {
		font-size: 14px;
		color: #666;
	}
</style>
