		background-color: #ECECEC;
	}

	.add-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		border: 1px solid #D9D9D9;
	}

	.plus-icon {
		width: 24px;
		height: 24px;
		position: relative;
	}

	.plus-icon .i1,
	.plus-icon .i2 {
		position: absolute;
		background-color: #B2B2B2;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
	}

	.plus-icon .i1 {
		width: 20px;
