<template>
	<view class="page">
		<!-- 状态栏占位 -->
		<view class="status-bar"></view>

		<!-- 自定义导航栏 -->
		<view class="nav-bar">
			<view class="back-arrow" @click="goBack"></view>
			<text class="nav-title">发表</text>
			<text class="post-btn" @click="onPost">发表</text>
		</view>

		<scroll-view class="content" scroll-y>
			<!-- 输入与图片区 -->
			<view class="input-card">
				<textarea
					class="content-input"
					v-model="content"
					placeholder="这一刻的想法..."
					placeholder-style="color: #B2B2B2"
					maxlength="2000"
					auto-height
				/>

				<view class="image-grid">
					<view
						class="grid-item placeholder"
						v-for="(_, index) in imageList"
						:key="index"
					></view>
					<view
						class="grid-item add-btn"
						v-if="imageList.length < 9"
						@click="onAddImage"
					>
						<view class="plus-icon">
						<view class="i1"></view>
						<view class="i2"></view>
					</view>
					</view>
				</view>
			</view>

			<!-- 功能菜单 -->
			<view class="menu-card">
				<view class="menu-item" @click="onMenuClick('所在位置')">
					<text class="menu-text">所在位置</text>
					<view class="arrow"></view>
				</view>
				<view class="menu-item" @click="onMenuClick('谁可以看')">
					<view class="menu-left">
						<text class="menu-text">公开</text>
						<view class="arrow"></view>
					</view>
					<text class="menu-right">谁可以看</text>
				</view>
				<view class="menu-item menu-item-last" @click="onMenuClick('提醒谁看')">
					<text class="menu-text">提醒谁看</text>
					<view class="arrow"></view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	const content = ref<string>('')
	const imageList = ref<string[]>(['', '', ''])

	const goBack = () => {
		uni.navigateBack()
	}

	const onPost = () => {
		uni.showToast({ title: '发表成功', icon: 'none' })
		setTimeout(() => {
			uni.navigateBack()
		}, 800)
	}

	const onAddImage = () => {
		if (imageList.value.length < 9) {
			imageList.value.push('')
		}
		uni.showToast({ title: '选择图片', icon: 'none' })
	}

	const onMenuClick = (name: string) => {
		uni.showToast({ title: name, icon: 'none' })
	}
</script>

<style scoped>
