<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="nav-bar">
			<view class="back-icon" @click="goBack"></view>
			<text class="nav-title">朋友圈权限</text>
		</view>
		<scroll-view class="content" scroll-y>
			<view class="card">
				<view class="row">
					<view class="row-text">
						<text class="row-title">允许朋友查看朋友圈的范围</text>
						<text class="row-sub">{{ rangeLabel }}</text>
					</view>
					<view class="toggle" :class="{ on: rangeOpen }" @click="rangeOpen = !rangeOpen">
						<view class="toggle-dot"></view>
					</view>
				</view>
				<view class="divider"></view>
				<view class="row">
					<view class="row-text">
						<text class="row-title">不让他（她）看我</text>
						<text class="row-sub">0 人</text>
					</view>
					<view class="toggle" :class="{ on: blockSeeMe }" @click="toggleBlockSeeMe">
						<view class="toggle-dot"></view>
					</view>
				</view>
				<view class="divider"></view>
				<view class="row">
					<view class="row-text">
						<text class="row-title">不看他（她）</text>
						<text class="row-sub">0 人</text>
					</view>
					<view class="toggle" :class="{ on: blockSeeThem }" @click="toggleBlockSeeThem">
						<view class="toggle-dot"></view>
					</view>
				</view>
			</view>

			<view class="card">
				<view class="row">
					<view class="row-text">
						<text class="row-title">允许朋友查看我的状态</text>
						<text class="row-sub">全部朋友</text>
					</view>
					<view class="toggle" :class="{ on: statusOpen }" @click="statusOpen = !statusOpen">
						<view class="toggle-dot"></view>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const rangeOpen = ref<boolean>(true)
const rangeLabel = ref<string>('最近三天')
const blockSeeMe = ref<boolean>(false)
const blockSeeThem = ref<boolean>(false)
const statusOpen = ref<boolean>(true)

const goBack = () => {
	uni.navigateBack({ delta: 1 })
}

const toggleBlockSeeMe = () => {
	blockSeeMe.value = !blockSeeMe.value
	uni.showToast({ title: '不让他(她)看我', icon: 'none' })
}

const toggleBlockSeeThem = () => {
	blockSeeThem.value = !blockSeeThem.value
	uni.showToast({ title: '不看他(她)', icon: 'none' })
}
</script>

