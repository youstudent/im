<template>
	<view class="page">
		<!-- 状态栏占位 -->
		<view class="status-bar"></view>

		<!-- 顶部导航 -->
		<view class="nav-bar">
			<view class="back-icon" @click="goBack"></view>
			<text class="nav-title">隐私</text>
			<view class="nav-right"></view>
		</view>

		<!-- 内容区 -->
		<scroll-view class="content" scroll-y>
			<view class="menu-group">
				<!-- 开关项：加我为朋友时需要验证 -->
				<view class="menu-item switch-item">
					<text class="menu-name">加我为朋友时需要验证</text>
					<switch :checked="verifyFriend" @change="onVerifyFriendChange" color="#07C160" />
				</view>

				<!-- 普通菜单项 -->
				<view
					class="menu-item"
					v-for="(item, index) in menuList"
					:key="item.key"
					:class="{ 'menu-item-last': index === menuList.length - 1 }"
					@click="onItemClick(item)"
				>
					<text class="menu-name">{{ item.name }}</text>
					<view class="arrow"></view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	type MenuItem = {
		key: string
		name: string
	}

	const verifyFriend = ref<boolean>(true)

	const menuList = ref<MenuItem[]>([
		{ key: 'moments_status', name: '朋友圈和状态' },
		{ key: 'personal_info', name: '个人信息与权限' },
		{ key: 'auth_manage', name: '授权管理' },
		{ key: 'third_party_share', name: '第三方信息共享清单' },
		{ key: 'info_collect', name: '个人信息收集清单' },
		{ key: 'system_auth', name: '系统权限管理' }
	])

	const goBack = () => {
		uni.navigateBack()
	}

	const onVerifyFriendChange = (e: SwitchChangeEvent) => {
		verifyFriend.value = e.detail.value
	}

	const onItemClick = (item: MenuItem) => {
		if (item.key === 'moments_status') {
			uni.navigateTo({ url: '/pages/settings-moments-auth/settings-moments-auth' })
			return
		}
		if (item.key === 'auth_manage') {
			uni.navigateTo({ url: '/pages/settings-auth/settings-auth' })
			return
		}
		uni.showToast({ title: item.name, icon: 'none' })
	}
</script>

<style>
	.page {
		display: flex;
		flex-direction: column;
		height: 100%;
		background-color: #F5F5F5;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #F8F8F8;
	}

	/* 顶部导航 */
	.nav-bar {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		height: 44px;
		padding: 0 8px;
		background-color: #F8F8F8;
		border-bottom: 1px solid #E5E5E5;
	}

	.back-icon {
		width: 11px;
		height: 11px;
		border-left: 2px solid #333;
		border-bottom: 2px solid #333;
		transform: rotate(45deg);
		margin-left: 8px;
	}

	.nav-title {
		font-size: 17px;
		color: #000;
		font-weight: 600;
	}

	.nav-right {
		width: 32px;
	}

	/* 内容区 */
	.content {
		flex: 1;
		background-color: #F5F5F5;
	}

	.menu-group {
		background-color: #FFFFFF;
		margin-top: 8px;
	}

	.menu-item {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		height: 50px;
		padding: 0 16px;
		background-color: #FFFFFF;
		border-bottom: 1px solid #E5E5E5;
		box-sizing: border-box;
	}

	.menu-item-last {
		border-bottom: none;
	}

	.switch-item {
		justify-content: space-between;
	}

	.menu-name {
		font-size: 16px;
		color: #000;
	}

	.arrow {
		width: 8px;
		height: 8px;
		border-top: 2px solid #C8C8C8;
		border-right: 2px solid #C8C8C8;
		transform: rotate(45deg);
	}
</style>
