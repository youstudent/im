<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="nav-bar">
			<view class="back-icon" @click="goBack"></view>
			<text class="nav-title">收付款</text>
		</view>

		<!-- Tab 切换 -->
		<view class="tab-bar">
			<view class="tab-item" :class="{ active: activeTab === 'pay' }" @click="switchTab('pay')">
				<text class="tab-text" :class="{ active: activeTab === 'pay' }">付款</text>
				<view class="tab-line" v-if="activeTab === 'pay'"></view>
			</view>
			<view class="tab-item" :class="{ active: activeTab === 'collect' }" @click="switchTab('collect')">
				<text class="tab-text" :class="{ active: activeTab === 'collect' }">收款</text>
				<view class="tab-line" v-if="activeTab === 'collect'"></view>
			</view>
		</view>

		<view class="content">
			<!-- 码卡片 -->
			<view class="qr-card">
				<view class="qr-box">
					<view class="qr-placeholder"></view>
				</view>
				<text class="qr-tip">{{ activeTab === 'pay' ? '向商家展示付款码' : '向对方展示收款码' }}</text>
				<view class="card-divider"></view>
				<view class="pay-method" @click="switchPayMethod">
					<text class="pay-method-text">付款方式  零钱</text>
					<text class="pay-method-arrow">›</text>
				</view>
			</view>

			<view class="gap"></view>

			<!-- 功能列表 -->
			<view class="list-card">
				<view class="list-item" @click="goTransfer">
					<view class="badge" style="background:#07C160;">转</view>
					<text class="item-text">转账</text>
					<text class="item-arrow">›</text>
				</view>
				<view class="line"></view>
				<view class="list-item" @click="goRedPacket">
					<view class="badge" style="background:#EE2C2C;">包</view>
					<text class="item-text">红包</text>
					<text class="item-arrow">›</text>
				</view>
				<view class="line"></view>
				<view class="list-item" @click="goScan">
					<view class="badge" style="background:#4A90E2;">扫</view>
					<text class="item-text">扫一扫</text>
					<text class="item-arrow">›</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	const activeTab = ref<string>('pay')

	const goBack = () => {
		uni.navigateBack({ delta: 1 })
	}
	const switchTab = (tab: string) => {
		activeTab.value = tab
	}
	const switchPayMethod = () => {
		uni.showToast({ title: '切换付款方式', icon: 'none' })
	}
	const goTransfer = () => {
		uni.navigateTo({ url: '/pages/transfer/transfer' })
	}
	const goRedPacket = () => {
		uni.navigateTo({ url: '/pages/red-packet-send/red-packet-send' })
	}
	const goScan = () => {
		uni.navigateTo({ url: '/pages/scan/scan' })
	}
</script>

