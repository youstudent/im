<template>
	<view class="page">
		<!-- 状态栏占位 -->
		<view class="status-bar"></view>

		<!-- 顶部导航 -->
		<view class="nav-bar">
			<view class="back-icon" @click="goBack"></view>
			<text class="nav-title">授权管理</text>
		</view>

		<!-- 内容区 -->
		<scroll-view class="content" scroll-y>
			<view class="desc">你已授权以下应用访问你的微信信息</view>

			<view class="card">
				<view class="auth-row" v-for="(item, index) in authList" :key="item.name" :class="{ 'auth-row-last': index === authList.length - 1 }">
					<view class="auth-icon" :style="{ backgroundColor: item.color }">
						<text class="auth-icon-text">{{ item.icon }}</text>
					</view>
					<view class="auth-info">
						<text class="auth-name">{{ item.name }}</text>
						<text class="auth-scope">{{ item.scope }}</text>
					</view>
					<text class="revoke-btn" @click="onRevoke(item.name)">解除</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	type AuthItem = {
		name: string
		scope: string
		color: string
		icon: string
	}

	const authList = ref<AuthItem[]>([
		{ name: '美团', scope: '好友信息 · 头像', color: '#1E88E5', icon: '美' },
		{ name: '京东', scope: '收货地址 · 订单', color: '#E53935', icon: '京' },
		{ name: '滴滴出行', scope: '位置信息', color: '#FF8C2A', icon: '滴' },
		{ name: '抖音', scope: '好友列表', color: '#1C1C1E', icon: '抖' }
	])

	const goBack = () => {
		uni.navigateBack({ delta: 1 })
	}

	const onRevoke = (name: string) => {
		uni.showModal({
			title: '提示',
			content: `确认解除 ${name} 的授权？`,
			confirmText: '解除',
			success: (r) => {
				if (r.confirm) {
					authList.value = authList.value.filter(a => a.name !== name)
					uni.showToast({ title: '已解除', icon: 'success' })
				}
			}
		})
	}
</script>

<style>
	.page {
		display: flex;
		flex-direction: column;
		height: 100%;
		background-color: #F7F7F7;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #FFFFFF;
	}

	/* 顶部导航 */
	.nav-bar {
		display: flex;
		flex-direction: row;
		align-items: center;
		height: 44px;
		padding: 0 16px;
		background-color: #FFFFFF;
	}

	.back-icon {
		width: 11px;
		height: 11px;
		border-left: 2px solid #333;
		border-bottom: 2px solid #333;
		transform: rotate(45deg);
		margin-right: 12px;
	}

	.nav-title {
		font-size: 17px;
		color: #000;
		font-weight: 600;
	}

	/* 内容区 */
	.content {
		flex: 1;
		background-color: #F7F7F7;
	}

	.desc {
		font-size: 13px;
		color: #888;
		padding: 16px 16px 12px 16px;
	}

	.card {
		background-color: #FFFFFF;
		margin: 0 12px 12px 12px;
		border-radius: 8px;
		overflow: hidden;
	}

	.auth-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		border-bottom: 1px solid #EEE;
	}

	.auth-row-last {
		border-bottom: none;
	}

	.auth-icon {
		width: 40px;
		height: 40px;
		border-radius: 8px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-right: 12px;
	}

	.auth-icon-text {
		font-size: 16px;
		color: #FFFFFF;
		font-weight: 600;
	}

	.auth-info {
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.auth-name {
		font-size: 16px;
		color: #333;
		margin-bottom: 2px;
	}

	.auth-scope {
		font-size: 12px;
		color: #999;
	}

	.revoke-btn {
		font-size: 15px;
		color: #EE2C2C;
		padding: 4px 0;
	}
</style>
