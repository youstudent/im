		color: #333;
	}

	.cancel-btn {
		font-size: 15px;
		color: #07C160;
		margin-left: 12px;
		flex-shrink: 0;
	}

	/* 内容区 */
	.content {
		flex: 1;
		background-color: #F5F5F5;
	}

	/* 分类入口 */
	.category-section {
		background-color: #FFFFFF;
		padding: 20px 16px 16px;
	}

	.category-row {
		display: flex;
		flex-direction: row;
		justify-content: flex-start;
	}

	.category-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-right: 24px;
	}

	.category-icon {
		width: 48px;
		height: 48px;
		border-radius: 10px;
		display: flex;
		justify-content: center;
		align-items: center;
		margin-bottom: 6px;
	}

	.category-text {
		font-size: 18px;
		color: #FFFFFF;
		font-weight: 500;
	}

	.category-label {
		font-size: 12px;
		color: #666;
	}

	/* 分类图标背景色 */
	.icon-bg-0 {
		background-color: #576B95;
	}

	.icon-bg-1 {
		background-color: #07C160;
