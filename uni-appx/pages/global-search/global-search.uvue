<template>
	<view class="page">
		<!-- 状态栏占位 -->
		<view class="status-bar"></view>

		<!-- 顶部导航 + 搜索栏 -->
		<view class="nav-bar">
			<view class="back-icon" @click="goBack"></view>
			<view class="search-bar">
				<view class="search-dot"></view>
				<input class="search-input" placeholder="搜索" :focus="true" confirm-type="search" />
			</view>
			<text class="cancel-btn" @click="goBack">取消</text>
		</view>

		<!-- 内容区 -->
		<scroll-view class="content" scroll-y>
			<!-- 搜索指定内容入口 -->
			<view class="category-section">
				<view class="category-row">
					<view
						class="category-item"
						v-for="(item, index) in categoryList"
						:key="index"
						@click="onCategoryClick(item)"
					>
						<view class="category-icon" :class="'icon-bg-' + index">
							<text class="category-text">{{ item.icon }}</text>
						</view>
						<text class="category-label">{{ item.label }}</text>
					</view>
				</view>
			</view>

			<!-- 热门搜索 -->
			<view class="section">
				<text class="section-title">热门搜索</text>
				<view class="tag-row">
					<text
						class="tag-item"
						:class="{ 'tag-item-last': index === hotTags.length - 1 }"
						v-for="(tag, index) in hotTags"
						:key="index"
						@click="onTagClick(tag)"
					>{{ tag }}</text>
				</view>
			</view>

			<!-- 搜索历史 -->
			<view class="section">
				<text class="section-title">搜索历史</text>
				<view class="history-card">
					<view
						class="history-item"
						v-for="(item, index) in historyList"
						:key="index"
						:class="{ 'history-item-last': index === historyList.length - 1 }"
						@click="onHistoryClick(item)"
					>
						<text class="history-text">{{ item }}</text>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	type CategoryItem = {
		icon: string
		label: string
	}

	const categoryList = ref<CategoryItem[]>([
		{ icon: '聊', label: '聊天' },
		{ icon: '联', label: '联系人' },
		{ icon: '公', label: '公众号' },
		{ icon: '文', label: '文章' }
	])

	const hotTags = ref<string[]>(['世界杯', 'iPhone 16', 'ChatGPT', '成都美食'])

	const historyList = ref<string[]>(['产品方案', '林晚', '天气预报'])

	const goBack = () => {
		uni.navigateBack()
	}

	const onCategoryClick = (item: CategoryItem) => {
		uni.showToast({ title: item.label, icon: 'none' })
	}

	const onTagClick = (tag: string) => {
		uni.showToast({ title: tag, icon: 'none' })
	}

	const onHistoryClick = (item: string) => {
		uni.showToast({ title: item, icon: 'none' })
	}
</script>

