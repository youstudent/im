<script setup lang="uts">
	const goBack = () => {
		uni.navigateBack({ delta: 1 })
	}

	const onLogout = (name: string) => {
		uni.showModal({
			title: '提示',
			content: `确认退出 ${name}？`,
			confirmText: '退出',
			success: (r) => {
				if (r.confirm) {
					uni.showToast({ title: '已退出', icon: 'success' })
				}
			}
		})
	}
</script>

