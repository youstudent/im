</template>

<script setup lang="uts">
	import { ref } from 'vue'

	const name = ref<string>('小 Work')
	const gender = ref<string>('男')
	const region = ref<string>('成都')
	const signature = ref<string>('热爱设计与咖啡')
	const wechatId = ref<string>('xiaowork')

	const goBack = () => {
		uni.navigateBack()
	}

	const onSave = () => {
		uni.showToast({ title: '保存成功', icon: 'none' })
	}

	const onAvatarClick = () => {
		uni.showToast({ title: '更换头像', icon: 'none' })
	}

	const onNameClick = () => {
		uni.showToast({ title: '编辑名字', icon: 'none' })
	}

	const onGenderClick = () => {
		uni.showToast({ title: '选择性别', icon: 'none' })
	}

	const onRegionClick = () => {
		uni.showToast({ title: '选择地区', icon: 'none' })
	}

	const onSignatureClick = () => {
		uni.showToast({ title: '编辑个性签名', icon: 'none' })
	}
</script>

