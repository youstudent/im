			<text class="nav-save" @click="onSave">保存</text>
		</view>

		<!-- 内容区 -->
		<scroll-view class="content" scroll-y>
			<view class="form-card">
				<!-- 头像行 -->
				<view class="form-item avatar-row" @click="onAvatarClick">
