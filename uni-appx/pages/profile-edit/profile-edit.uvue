					<text class="form-value">{{ name }}</text>
					<view class="arrow"></view>
				</view>

				<!-- 性别 -->
				<view class="form-item" @click="onGenderClick">
					<text class="form-label">性别</text>
					<text class="form-value">{{ gender }}</text>
					<view class="arrow"></view>
				</view>

				<!-- 地区 -->
				<view class="form-item" @click="onRegionClick">
