<template>
	<view class="page">
		<!-- 状态栏占位 -->
		<view class="status-bar"></view>

		<!-- 顶部导航 -->
		<view class="nav-bar">
			<view class="back-icon" @click="goBack"></view>
			<text class="nav-title">文件传输助手</text>
			<view class="more-icon" @click="onMore">
				<view class="dot"></view>
				<view class="dot"></view>
				<view class="dot"></view>
			</view>
		</view>

		<!-- 消息列表 -->
		<scroll-view class="message-scroll" scroll-y>
			<view class="message-list">
				<view
					class="message-row"
					v-for="msg in messages"
					:key="msg.id"
					:class="msg.type"
				>
					<view v-if="msg.type === 'time'" class="time-badge">
						<text class="time-text">{{ msg.content }}</text>
					</view>

					<template v-else-if="msg.type === 'incoming'">
						<view class="message-avatar" :style="{ backgroundColor: msg.avatarColor }">
							<text class="message-avatar-text">{{ msg.avatarText }}</text>
						</view>

						<view v-if="msg.subType === 'text'" class="message-bubble bubble-white">
							<text class="message-text">{{ msg.content }}</text>
						</view>

						<view v-else-if="msg.subType === 'image'" class="media-bubble image-bubble" @click="onPreviewMedia(msg)">
							<text class="image-placeholder">照片</text>
						</view>

						<view v-else-if="msg.subType === 'voice'" class="media-bubble voice-bubble" @click="onPlayVoice(msg)">
							<view class="voice-play-icon"></view>
							<view class="voice-wave">
								<view class="wave-bar" v-for="h in waveHeights" :key="h" :style="{ height: h + 'px' }"></view>
							</view>
							<text class="voice-duration">{{ msg.duration }}"</text>
						</view>

						<view v-else-if="msg.subType === 'video'" class="media-bubble video-bubble" @click="onPlayVideo(msg)">
							<view class="video-play-btn">
								<view class="video-triangle"></view>
							</view>
							<text class="video-duration">{{ msg.duration }}</text>
						</view>

						<view v-else-if="msg.subType === 'redpacket'" class="media-bubble redpacket-bubble" @click="onOpenRedPacket(msg)">
							<view class="redpacket-header">
								<view class="redpacket-icon">
								<view class="i1"></view>
							</view>
								<text class="redpacket-title">微信红包</text>
							</view>
							<text class="redpacket-text">{{ msg.content }}</text>
						</view>

						<view v-else-if="msg.subType === 'transfer'" class="media-bubble transfer-bubble" @click="onViewTransfer(msg)">
							<view class="transfer-header">
								<view class="transfer-icon">¥</view>
								<text class="transfer-text">{{ msg.content }}</text>
							</view>
						</view>

						<view v-else-if="msg.subType === 'location'" class="media-bubble location-bubble" @click="onViewLocation(msg)">
							<view class="location-map">
								<view class="location-pin"></view>
							</view>
							<view class="location-info">
								<text class="location-title">{{ msg.title }}</text>
								<text class="location-address">{{ msg.address }}</text>
							</view>
						</view>
					</template>

					<template v-else-if="msg.type === 'outgoing'">
						<view v-if="msg.subType === 'text'" class="message-bubble bubble-green">
							<text class="message-text">{{ msg.content }}</text>
						</view>
					</template>
				</view>
			</view>
		</scroll-view>

		<!-- 底部输入栏（公共组件） -->
		<chat-input-bar
			:placeholder="'发送消息'"
			:showAt="false"
			@send="sendMessage"
			@voice="onVoice"
			@more="onMoreAction"
		></chat-input-bar>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'

	type Message = {
		id: string
		type: string
		subType?: string
		content?: string
		duration?: string
		title?: string
		address?: string
		avatarText?: string
		avatarColor?: string
	}

	const waveHeights = [6, 12, 18, 10, 16, 8, 14]

	const messages = ref<Message[]>([
		{ id: 't1', type: 'time', content: '14:12' },
		{
			id: 'm1',
			type: 'incoming',
			subType: 'image',
			avatarText: '文',
			avatarColor: '#5B6BFF'
		},
		{
			id: 'm2',
			type: 'incoming',
			subType: 'voice',
			duration: '3',
			avatarText: '文',
			avatarColor: '#5B6BFF'
		},
		{
			id: 'm3',
			type: 'incoming',
			subType: 'video',
			duration: '00:12',
			avatarText: '文',
			avatarColor: '#5B6BFF'
		},
		{
			id: 'm4',
			type: 'incoming',
			subType: 'redpacket',
			content: '恭喜发财，大吉大利',
			avatarText: '文',
			avatarColor: '#5B6BFF'
		},
		{
			id: 'm5',
			type: 'incoming',
			subType: 'transfer',
			content: '转账 ¥200.00',
			avatarText: '文',
			avatarColor: '#5B6BFF'
		},
		{
			id: 'm6',
			type: 'incoming',
			subType: 'location',
			title: '成都市天府广场',
			address: '人民南路一段',
			avatarText: '文',
			avatarColor: '#5B6BFF'
		}
	])

	const goBack = () => {
		uni.navigateBack({ animationType: 'slide-in-right', animationDuration: 300 })
	}

	const onMore = () => {
		uni.navigateTo({ url: '/pages/chat-detail/chat-detail' })
	}

	const onVoice = () => {
		uni.showToast({ title: '语音输入', icon: 'none' })
	}

	const onMoreAction = () => {
		uni.navigateTo({ url: '/pages/chat-search/chat-search' })
	}

	const onPreviewMedia = (msg: Message) => {
		uni.showToast({ title: '预览媒体', icon: 'none' })
	}

	const onPlayVoice = (msg: Message) => {
		uni.showToast({ title: '播放语音', icon: 'none' })
	}

	const onPlayVideo = (msg: Message) => {
		uni.showToast({ title: '播放视频', icon: 'none' })
	}

	const onOpenRedPacket = (msg: Message) => {
		uni.showToast({ title: '打开红包', icon: 'none' })
	}

	const onViewTransfer = (msg: Message) => {
		uni.showToast({ title: '查看转账', icon: 'none' })
	}

	const onViewLocation = (msg: Message) => {
		uni.showToast({ title: '查看位置', icon: 'none' })
	}

	const sendMessage = (text: string) => {
		if (text.length === 0) return
		const message: Message = {
			id: `m${Date.now()}`,
			type: 'outgoing',
			subType: 'text',
			content: text
		}
		messages.value.push(message)
	}
</script>

<style>
	.page {
		display: flex;
		flex-direction: column;
		height: 100%;
		background-color: #F0F0F0;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #F8F8F8;
	}

	/* 顶部导航 */
	.nav-bar {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		height: 44px;
		padding: 0 8px;
		background-color: #F8F8F8;
		border-bottom: 1px solid #E5E5E5;
	}

	.back-icon {
		width: 11px;
		height: 11px;
		border-left: 2px solid #333;
		border-bottom: 2px solid #333;
		transform: rotate(45deg);
		margin-left: 8px;
	}

	.nav-title {
		font-size: 17px;
		color: #000;
		font-weight: 600;
	}

	.more-icon {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 8px;
	}

	.dot {
		width: 4px;
		height: 4px;
		background-color: #333;
		border-radius: 50%;
		margin: 0 1.5px;
	}

	/* 消息列表 */
	.message-scroll {
		flex: 1;
		background-color: #F0F0F0;
		padding: 12px 0;
	}

	.message-list {
		padding: 0 12px;
	}

	.message-row {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		margin-bottom: 16px;
	}

	.message-row.time {
		justify-content: center;
	}

	.message-row.incoming {
		justify-content: flex-start;
	}

	.message-row.outgoing {
		justify-content: flex-end;
	}

	.time-badge {
		background-color: #DADADA;
		border-radius: 4px;
		padding: 3px 6px;
		margin: 4px 0;
	}

	.time-text {
		font-size: 11px;
		color: #FFFFFF;
	}

	.message-avatar {
		width: 40px;
		height: 40px;
		border-radius: 6px;
		display: flex;
		justify-content: center;
		align-items: center;
		margin-right: 10px;
		flex-shrink: 0;
	}

	.message-avatar-text {
		font-size: 15px;
		color: #FFFFFF;
		font-weight: 500;
	}

	.message-bubble {
		max-width: 280px;
		padding: 10px 12px;
		border-radius: 6px;
	}

	.bubble-white {
		background-color: #FFFFFF;
	}

	.bubble-green {
		background-color: #95EC69;
	}

	.message-text {
		font-size: 15px;
		color: #000;
		line-height: 1.4;
	}

	/* 媒体消息卡片 */
	.media-bubble {
		border-radius: 6px;
		overflow: hidden;
	}

	.image-bubble {
		width: 150px;
		height: 150px;
		background-color: #D8D8D8;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.image-placeholder {
		font-size: 16px;
		color: #999;
	}

	.voice-bubble {
		width: 180px;
		height: 44px;
		background-color: #FFFFFF;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
	}

	.voice-play-icon {
		width: 0;
		height: 0;
		border-top: 6px solid transparent;
		border-bottom: 6px solid transparent;
		border-left: 10px solid #333;
		margin-right: 10px;
	}

	.voice-wave {
		display: flex;
		flex-direction: row;
		align-items: center;
		flex: 1;
		height: 20px;
	}

	.wave-bar {
		width: 3px;
		background-color: #333;
		border-radius: 1px;
		margin-right: 3px;
	}

	.voice-duration {
		font-size: 13px;
		color: #999;
		margin-left: 8px;
	}

	.video-bubble {
		width: 200px;
		height: 140px;
		background-color: #333;
		display: flex;
		justify-content: center;
		align-items: center;
		position: relative;
	}

	.video-play-btn {
		width: 48px;
		height: 48px;
		background-color: rgba(255, 255, 255, 0.2);
		border-radius: 50%;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.video-triangle {
		width: 0;
		height: 0;
		border-top: 10px solid transparent;
		border-bottom: 10px solid transparent;
		border-left: 16px solid #FFFFFF;
		margin-left: 4px;
	}

	.video-duration {
		position: absolute;
		bottom: 6px;
		right: 8px;
		font-size: 12px;
		color: #FFFFFF;
	}

	.redpacket-bubble {
		width: 220px;
		background-color: #FA9D3B;
		padding: 12px;
	}

	.redpacket-header {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-bottom: 8px;
	}

	.redpacket-icon {
		width: 28px;
		height: 28px;
		background-color: #FFE6B5;
		border-radius: 50%;
		margin-right: 8px;
		position: relative;
	}

	.redpacket-icon .i1 {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 16px;
		height: 10px;
		background-color: #FA9D3B;
		border-radius: 2px;
	}

	.redpacket-title {
		font-size: 16px;
		color: #FFFFFF;
		font-weight: 500;
	}

	.redpacket-text {
		font-size: 14px;
		color: #FFFFFF;
	}

	.transfer-bubble {
		width: 220px;
		background-color: #FA9D3B;
		padding: 12px;
	}

	.transfer-header {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.transfer-icon {
		width: 32px;
		height: 32px;
		background-color: #FFFFFF;
		border-radius: 50%;
		display: flex;
		justify-content: center;
		align-items: center;
		font-size: 18px;
		color: #FA9D3B;
		font-weight: 600;
		margin-right: 10px;
	}

	.transfer-text {
		font-size: 16px;
		color: #FFFFFF;
		font-weight: 500;
	}

	.location-bubble {
		width: 220px;
		background-color: #FFFFFF;
	}

	.location-map {
		width: 220px;
		height: 100px;
		background-color: #D8D8D8;
		display: flex;
		justify-content: center;
		align-items: center;
		position: relative;
	}

	.location-pin {
		width: 24px;
		height: 24px;
		background-color: #FF3B30;
		border-radius: 50% 50% 50% 0;
		transform: rotate(-45deg);
	}

	.location-info {
		padding: 10px 12px;
	}

	.location-title {
		font-size: 15px;
		color: #000;
		font-weight: 500;
	}

	.location-address {
		font-size: 12px;
		color: #999;
		margin-top: 4px;
	}

</style>
