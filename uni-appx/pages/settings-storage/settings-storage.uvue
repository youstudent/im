<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="nav-bar">
			<view class="back-icon" @click="goBack"></view>
			<text class="nav-title">存储空间</text>
		</view>
		<scroll-view class="content" scroll-y>
			<view class="usage-area">
				<view class="circle">
					<text class="circle-text">已用 3.2 GB</text>
				</view>
			</view>

			<view class="card">
				<view class="row" @click="onTap('聊天记录')">
					<text class="row-text">聊天记录</text>
					<text class="row-val">2.1 GB</text>
				</view>
				<view class="divider"></view>
				<view class="row" @click="onTap('缓存')">
					<text class="row-text">缓存</text>
					<text class="row-val">0.8 GB</text>
				</view>
				<view class="divider"></view>
				<view class="row" @click="onTap('其他')">
					<text class="row-text">其他</text>
					<text class="row-val">0.3 GB</text>
				</view>
			</view>

			<view class="card" @click="onClearCache">
				<view class="clear-row">
					<text class="clear-text">清理缓存</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const goBack = () => {
	uni.navigateBack({ delta: 1 })
}

const onTap = (name: string) => {
	uni.showToast({ title: name, icon: 'none' })
}

const onClearCache = () => {
	uni.showModal({
		title: '提示',
		content: '确认清理缓存？',
		confirmText: '清理',
		success: (r) => {
			if (r.confirm) {
				uni.showToast({ title: '已清理', icon: 'success' })
			}
		}
	})
}
</script>

