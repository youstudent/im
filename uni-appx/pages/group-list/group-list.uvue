						<view class="group-row">
							<text class="group-msg">{{ item.lastMsg }}</text>
							<view class="badge" v-if="item.unread > 0">
								<text class="badge-text">{{ item.unread }}</text>
							</view>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	type GroupItem = {
		id: number
		name: string
		avatarColor: string
		lastMsg: string
		time: string
		unread: number
	}

	const groups = ref<GroupItem[]>([
		{ id: 1, name: '产品交流群', avatarColor: '#07C160', lastMsg: '张可：大家好，新版本发布啦', time: '14:05', unread: 3 },
		{ id: 2, name: '家人朋友', avatarColor: '#F5A623', lastMsg: '妈妈：记得按时吃饭', time: '昨天', unread: 0 },
