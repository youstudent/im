		</view>

		<scroll-view class="scroll" scroll-y>
			<view class="group-list">
				<view class="group-item" v-for="(item, index) in groups" :key="item.id" :class="{ 'group-item-last': index === groups.length - 1 }" @click="onItemClick(item)">
					<view class="group-avatar" :style="{ backgroundColor: item.avatarColor }">
						<view class="group-icon">
							<view class="person person-front">
								<view class="i1"></view>
