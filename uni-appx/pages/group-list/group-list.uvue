		{ id: 4, name: '羽毛球约球', avatarColor: '#07C160', lastMsg: '王强：周六开打！', time: '周一', unread: 0 },
		{ id: 5, name: '读书会', avatarColor: '#9B59B6', lastMsg: '[图片]', time: '上周', unread: 0 }
	])

	const goBack = () => {
		uni.navigateBack({})
	}

	const onItemClick = (item: GroupItem) => {
		uni.navigateTo({ url: '/pages/group-chat/group-chat' })
	}
</script>

