<template>
	<view class="voip-page">
		<!-- 状态栏占位 -->
		<view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

		<!-- 主内容区 -->
		<view class="content">
			<!-- 对方头像 -->
			<view class="avatar-wrap">
				<view class="avatar" :style="{ backgroundColor: avatarColor }">
					<text class="avatar-text">{{ avatarText }}</text>
				</view>
			</view>

			<!-- 昵称 -->
			<text class="nickname">{{ nickname }}</text>

			<!-- 通话结束提示 -->
			<text class="end-tip">通话结束</text>

			<!-- 通话时长 -->
			<text class="duration">通话时长 {{ displayTime }}</text>
		</view>

		<!-- 底部操作按钮 -->
		<view class="bottom-actions">
			<view class="action-btn callback-btn" @click="onCallback">
				<view class="callback-icon">
					<view class="i1"></view>
					<view class="i2"></view>
				</view>
			</view>
			<view class="action-btn message-btn action-last" @click="onMessage">
				<text class="message-text">信</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, onMounted, computed } from 'vue'

	const statusBarHeight = ref<number>(44)
	const nickname = ref<string>('林晚')
	const durationSeconds = ref<number>(12) // 通话时长（秒）

	const avatarText = computed<string>(() : string => {
		return nickname.value.length > 0 ? nickname.value.substring(0, 1) : '?'
	})

	// 根据昵称生成固定颜色
	const avatarColor = computed<string>(() : string => {
		const colors = ['#4A90D9', '#E07856', '#5BBF6A', '#D4A15B', '#8B6BB3', '#CC5555']
		let hash = 0
		for (let i = 0; i < nickname.value.length; i++) {
			const charCode = nickname.value.charCodeAt(i)
			if (charCode != null) {
				hash = ((hash << 5) - hash + charCode) | 0
			}
		}
		return colors[Math.abs(hash) % colors.length]
	})

	// 格式化显示时间 MM:SS
	const displayTime = computed<string>(() : string => {
		const m = Math.floor(durationSeconds.value / 60)
		const s = durationSeconds.value % 60
		const mStr = m < 10 ? '0' + m.toString() : m.toString()
		const sStr = s < 10 ? '0' + s.toString() : s.toString()
		return mStr + ':' + sStr
	})

	onMounted(() => {
		try {
			const info = uni.getSystemInfoSync()
			statusBarHeight.value = info.statusBarHeight || 44
		} catch (e) {}

		// 读取页面参数
		const pages = getCurrentPages()
		if (pages.length > 0) {
			const curPage = pages[pages.length - 1] as UniPage
			const options = curPage.options
			const name = options['name']
			const duration = options['duration']
			if (name != null) {
				nickname.value = name as string
			}
			if (duration != null) {
				const d = parseInt(duration as string, 10)
				if (!isNaN(d)) {
					durationSeconds.value = d
				}
			}
		}
	})

	const onCallback = () => {
		uni.redirectTo({ url: '/pages/voip-calling/voip-calling?name=' + nickname.value })
	}

	const onMessage = () => {
		uni.navigateBack({})
	}
</script>

<style scoped>
	.voip-page {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: #1A1A1A;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.status-bar {
		width: 100%;
		background-color: #1A1A1A;
	}

	.content {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding-bottom: 60px;
	}

	.avatar-wrap {
		margin-bottom: 24px;
	}

	.avatar {
		width: 110px;
		height: 110px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.avatar-text {
		font-size: 40px;
		color: #FFFFFF;
		font-weight: 500;
	}

	.nickname {
		font-size: 22px;
		color: #FFFFFF;
		font-weight: 500;
		margin-bottom: 12px;
	}

	.end-tip {
		font-size: 16px;
		color: #CCCCCC;
		margin-bottom: 8px;
	}

	.duration {
		font-size: 14px;
		color: #888888;
	}

	.bottom-actions {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding-bottom: 60px;
	}

	.action-btn {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
	}

	.callback-btn {
		background-color: #07C160;
		margin-right: 70px;
	}

	.message-btn {
		background-color: #3A3A3A;
	}

	.action-last {
		margin-right: 0;
	}

	.message-text {
		font-size: 22px;
		color: #FFFFFF;
		font-weight: 500;
	}

	/* 回拨图标：电话听筒 */
	.callback-icon {
		width: 24px;
		height: 24px;
		position: relative;
	}

	.callback-icon .i1 {
		position: absolute;
		top: 6px;
		left: 3px;
		width: 16px;
		height: 10px;
		border: 2.5px solid #FFFFFF;
		border-top: none;
		border-radius: 0 0 8px 8px;
		transform: rotate(-45deg);
		box-sizing: border-box;
	}

	.callback-icon .i2 {
		position: absolute;
		top: 6px;
		right: 3px;
		width: 16px;
		height: 10px;
		border: 2.5px solid #FFFFFF;
		border-top: none;
		border-radius: 0 0 8px 8px;
		transform: rotate(45deg);
		box-sizing: border-box;
	}
</style>
