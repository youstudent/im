<template>
	<view class="page">
		<!-- 自定义导航栏 -->
		<view class="nav-bar">
			<view class="back-arrow" @click="goBack"></view>
			<text class="nav-title">朋友圈</text>
			<view class="camera-icon" @click="onCamera">
				<view class="i1"></view>
				<view class="i2"></view>
			</view>
		</view>

		<scroll-view class="scroll" scroll-y>
			<!-- 封面区 -->
			<view class="cover" @click="goMyMoments">
				<view class="cover-bg"></view>
				<view class="my-avatar">
					<text class="my-avatar-text">小</text>
				</view>
			</view>

			<!-- 动态列表 -->
			<view class="moment-list">
				<view class="moment-item" v-for="item in moments" :key="item.id" @click="onItemTap(item)">
					<view class="avatar" :style="{ backgroundColor: item.avatarColor }" @click.stop="goAlbum(item)">
						<text class="avatar-text">{{ item.avatarText }}</text>
					</view>
					<view class="moment-body">
						<text class="nickname">{{ item.name }}</text>
						<text class="moment-text">{{ item.content }}</text>
						<view class="image-grid" v-if="item.images.length > 0">
							<view
								class="grid-image"
								v-for="(img, idx) in item.images"
								:key="idx"
								:style="{ backgroundColor: img }"
							></view>
						</view>
						<view class="moment-meta">
							<text class="time">{{ item.time }}</text>
							<view class="comment-btn" @click.stop="onComment(item)">
								<view class="comment-icon">
									<view class="i1"></view>
								</view>
							</view>
						</view>
						<view class="like-wrap" v-if="item.likes">
							<view class="heart-icon">
								<view class="i1"></view>
								<view class="i2"></view>
							</view>
							<text class="like-names">{{ item.likes }}</text>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	type MomentItem = {
		id: number
		name: string
		avatarText: string
		avatarColor: string
		content: string
		images: string[]
		time: string
		likes: string
	}

	const moments = ref<MomentItem[]>([
		{
			id: 1,
			name: '林晚',
			avatarText: '林',
			avatarColor: '#F5A623',
			content: '周末爬山太开心了，山顶风景美爆！下次约起',
			images: ['#E0E0E0', '#C5D8E8', '#E8D8C5'],
			time: '2 小时前',
			likes: ''
		},
		{
			id: 2,
			name: '张可',
			avatarText: '张',
			avatarColor: '#4A90E2',
			content: '新入手的咖啡机，拉花成功！',
			images: ['#D0C4A8'],
			time: '昨天',
			likes: '林晚、赵敏'
		},
		{
			id: 3,
			name: '李娜',
			avatarText: '李',
			avatarColor: '#FF6B9D',
			content: '',
			images: [],
			time: '',
			likes: ''
		}
	])

	const goBack = () => {
		uni.navigateBack({})
	}

	const onCamera = () => {
		uni.navigateTo({ url: '/pages/post-moment/post-moment' })
	}

	const onComment = (item: MomentItem) => {
		uni.showToast({ title: `评论 ${item.name}`, icon: 'none' })
	}

	const goMyMoments = () => {
		uni.navigateTo({ url: '/pages/moments-my/moments-my' })
	}

	const onItemTap = (item: MomentItem) => {
		uni.navigateTo({ url: '/pages/moment-detail/moment-detail' })
	}

	const goAlbum = (item: MomentItem) => {
		uni.navigateTo({ url: '/pages/moments-album/moments-album' })
	}
</script>

