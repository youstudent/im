<template>
	<view class="splash-page">
		<!-- 状态栏占位 -->
		<view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

		<view class="content">
			<view class="logo">
				<view class="face">
					<view class="eyes">
						<view class="eye"></view>
						<view class="eye"></view>
					</view>
					<view class="mouth"></view>
				</view>
			</view>
			<text class="brand">WorkChat</text>
			<text class="slogan">连接每一刻</text>
		</view>

		<text class="version">WorkChat 1.0.0</text>
	</view>
</template>

<script setup lang="uts">
	import { ref, onMounted } from 'vue'

	const statusBarHeight = ref<number>(44)

	try {
		const info = uni.getSystemInfoSync()
		statusBarHeight.value = info.statusBarHeight || 44
	} catch (e) {}

	onMounted(() => {
		setTimeout(() => {
			uni.redirectTo({
				url: '/pages/login/login'
			})
		}, 2000)
	})
</script>

