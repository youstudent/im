<template>
	<view class="page">
		<!-- 状态栏占位 -->
		<view class="status-bar"></view>

		<!-- 顶部导航 -->
		<view class="nav-bar">
			<view class="back-icon" @click="goBack"></view>
			<text class="nav-title">帮助与反馈</text>
			<view class="nav-right"></view>
		</view>

		<!-- 内容区 -->
		<scroll-view class="content" scroll-y>
			<!-- 搜索框 -->
			<view class="search-box">
				<view class="search-dot"></view>
				<input class="search-input" placeholder="遇到问题？搜索" />
			</view>

			<!-- 常见问题 -->
			<text class="section-title">常见问题</text>
			<view class="faq-card">
				<view
					class="faq-item"
					v-for="(item, index) in faqList"
					:key="item.key"
					:class="{ 'faq-item-last': index === faqList.length - 1 }"
					@click="onItemClick(item)"
				>
					<text class="faq-text">{{ item.question }}</text>
					<view class="arrow"></view>
				</view>
			</view>

			<!-- 意见反馈按钮 -->
			<view class="feedback-btn" @click="onFeedback">
				<text class="feedback-btn-text">意见反馈</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	type FaqItem = {
		key: string
		question: string
	}

	const faqList = ref<FaqItem[]>([
		{ key: 'add_friend', question: '如何添加好友？' },
		{ key: 'change_id', question: '怎么修改微信号？' },
		{ key: 'recover_chat', question: '聊天记录怎么恢复？' },
		{ key: 'pay_issue', question: '支付遇到问题怎么办？' }
	])

	const goBack = () => {
		uni.navigateBack()
	}

	const onItemClick = (item: FaqItem) => {
		uni.showToast({ title: item.question, icon: 'none' })
	}

	const onFeedback = () => {
		uni.showToast({ title: '意见反馈', icon: 'none' })
	}
</script>

