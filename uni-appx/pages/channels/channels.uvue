<template>
  <view class="page">
    <view class="status-bar"></view>
    <view class="nav-bar">
      <text class="nav-title">视频号</text>
      <view class="nav-actions">
        <text class="search-link" @click="onSearch">搜索</text>
        <view class="more-icon" @click="onMore">
          <text class="dot"></text>
          <text class="dot"></text>
          <text class="dot"></text>
        </view>
      </view>
    </view>
    <view class="tab-bar">
      <view
        class="tab-item"
        :class="{ active: activeTab === 'follow' }"
        @click="switchTab('follow')"
      >
        <text class="tab-text">关注</text>
        <view class="tab-line" v-if="activeTab === 'follow'"></view>
      </view>
      <view
        class="tab-item"
        :class="{ active: activeTab === 'recommend' }"
        @click="switchTab('recommend')"
      >
        <text class="tab-text">推荐</text>
        <view class="tab-line" v-if="activeTab === 'recommend'"></view>
      </view>
    </view>
    <scroll-view scroll-y="true" class="video-list">
      <view
        class="video-card"
        v-for="(item, idx) in videos"
        :key="idx"
        @click="onPlay(item)"
      >
        <view class="cover">
          <view class="play-icon"></view>
        </view>
        <view class="author-row">
          <view class="avatar"></view>
          <text class="author-name">{{ item.author }}</text>
        </view>
        <text class="video-desc">{{ item.desc }}</text>
        <view class="action-row" v-if="item.likes > 0 || item.comments > 0">
          <text class="action-text" @click.stop="onLike">赞 {{ item.likes }}</text>
          <text class="action-text" @click.stop="onComment">评论 {{ item.comments }}</text>
          <text class="action-text" @click.stop="onShare">分享</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const activeTab = ref<string>('follow')

type VideoItem = {
  author: string
  desc: string
  likes: number
  comments: number
}

const videos = ref<VideoItem[]>([
  {
    author: '林晚',
    desc: '周末去成都东站接朋友，顺便吃了顿火锅～',
    likes: 128,
    comments: 32
  },
  {
    author: '林晚',
    desc: '今天的晚霞也太好看了吧',
    likes: 0,
    comments: 0
  }
])

const goBack = () => {
  uni.navigateBack({ delta: 1 })
}

const switchTab = (tab: string) => {
  activeTab.value = tab
}

const onSearch = () => {
  uni.showToast({ title: '搜索视频号', icon: 'none' })
}

const onMore = () => {
  uni.showToast({ title: '更多', icon: 'none' })
}

const onPlay = (item: VideoItem) => {
  uni.showToast({ title: '播放：' + item.desc, icon: 'none' })
}

const onLike = () => {
  uni.showToast({ title: '已点赞', icon: 'success' })
}

const onComment = () => {
  uni.showToast({ title: '评论', icon: 'none' })
}

const onShare = () => {
  uni.showToast({ title: '分享', icon: 'none' })
}
</script>

