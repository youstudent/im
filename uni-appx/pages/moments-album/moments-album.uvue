<template>
  <view class="page">
    <view class="status-bar"></view>
    <view class="nav-bar">
      <view class="back-icon" @click="goBack"></view>
      <view class="nav-right" @click="onMore">
        <text class="nav-dots">···</text>
      </view>
    </view>

    <scroll-view class="content" scroll-y>
      <view class="cover">
        <view class="cover-mask"></view>
        <view class="cover-bottom">
          <text class="cover-name">林小北</text>
          <view class="cover-avatar">
            <text class="cover-avatar-text">林</text>
          </view>
        </view>
      </view>

      <view class="post-card">
        <view class="date-block">
          <text class="date-day">18</text>
          <text class="date-month">8月</text>
        </view>
        <view class="post-text-wrap">
          <text class="post-text">周末上山看云海，四点半起床是值得的。</text>
        </view>
        <view class="photo-grid">
          <view
            v-for="(item, index) in photos"
            :key="index"
            class="photo-item"
            :class="{ 'photo-item-last-row': (index + 1) % 2 === 0, 'photo-item-last': index === photos.length - 1 }"
            :style="{ background: item }"
            @click="onPhoto"
          ></view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
const goBack = (): void => {
  uni.navigateBack({ delta: 1 })
}

const onMore = (): void => {
  uni.showActionSheet({
    itemList: ['分享相册', '编辑信息', '删除相册'],
    success: (res) => {
      uni.showToast({ title: '已选择：' + (res.tapIndex + 1), icon: 'none' })
    }
  })
}

const onPhoto = (): void => {
  uni.showToast({ title: '查看照片', icon: 'none' })
}

const photos: string[] = [
  'linear-gradient(135deg, #FFB347 0%, #FFCC70 100%)',
  'linear-gradient(135deg, #4A5568 0%, #2D3748 100%)',
  'linear-gradient(135deg, #9AE6B4 0%, #68D391 100%)'
]
</script>

