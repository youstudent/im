<template>
	<view class="scan-page">
		<!-- 状态栏占位 -->
		<view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

		<!-- 顶部导航 -->
		<view class="nav-bar">
			<view class="back-arrow" @click="goBack"></view>
			<text class="nav-title">扫一扫</text>
		</view>

		<!-- 扫描区域 -->
		<view class="scan-area">
			<view class="scan-frame">
				<view class="corner corner-tl"></view>
				<view class="corner corner-tr"></view>
				<view class="corner corner-bl"></view>
				<view class="corner corner-br"></view>
				<view class="scan-line"></view>
			</view>
			<text class="scan-tip">将二维码放入框内，即可自动扫描</text>
		</view>

		<!-- 底部操作 -->
		<view class="action-bar">
			<view class="action-item" @click="onLight">
				<view class="action-icon icon-light">
					<view class="i1"></view>
					<view class="i2"></view>
				</view>
				<text class="action-label">轻触照亮</text>
			</view>
			<view class="action-item" @click="onAlbum">
				<view class="action-icon icon-album">
					<view class="i1"></view>
					<view class="i2"></view>
				</view>
				<text class="action-label">相册</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, onMounted } from 'vue'

	const statusBarHeight = ref<number>(44)

	onMounted(() => {
		try {
			const info = uni.getSystemInfoSync()
			statusBarHeight.value = info.statusBarHeight || 44
		} catch (e) {}
	})

	const goBack = () => {
		uni.navigateBack({})
	}

	const onLight = () => {
		uni.showToast({ title: '照亮', icon: 'none' })
	}

	const onAlbum = () => {
		uni.showToast({ title: '从相册选择', icon: 'none' })
	}
</script>

