			<view class="nav-title"></view>
			<view class="nav-right"></view>
		</view>

		<!-- 内容区 -->
		<view class="content">
			<!-- 黄色圆 + 金额 -->
			<view class="coin">
				<view class="coin-row">
					<text class="coin-symbol">¥</text>
					<text class="coin-value">88.88</text>
				</view>
			</view>

			<!-- 标题与说明 -->
			<text class="title">林晚 的红包</text>
			<text class="desc">已存入零钱，可用于发红包</text>

			<!-- 收下按钮 -->
			<view class="btn-wrap">
				<view class="btn-primary" @click="onReceive">
					<text class="btn-primary-text">开心收下</text>
				</view>
