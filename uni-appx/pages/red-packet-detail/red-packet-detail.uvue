<script setup lang="uts">
const goBack = () => {
	uni.navigateBack({ delta: 1 })
}

const onReceive = () => {
	uni.showToast({ title: '已存入零钱', icon: 'success' })
	setTimeout(() => {
		uni.navigateBack({ delta: 1 })
	}, 2000)
}

const onViewDetail = () => {
	uni.showToast({ title: '查看领取详情', icon: 'none' })
}
</script>

