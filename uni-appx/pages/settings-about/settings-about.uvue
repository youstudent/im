<template>
	<view class="page">
		<!-- 状态栏占位 -->
		<view class="status-bar"></view>

		<!-- 顶部导航 -->
		<view class="nav-bar">
			<view class="back-icon" @click="goBack"></view>
			<text class="nav-title">关于微信</text>
			<view class="nav-right"></view>
		</view>

		<!-- 内容区 -->
		<scroll-view class="content" scroll-y>
			<!-- Logo 区域 -->
			<view class="logo-area">
				<text class="logo-text">chat</text>
				<text class="version-text">chat 8.0.50</text>
			</view>

			<!-- 菜单列表 -->
			<view class="menu-group">
				<view
					class="menu-item"
					v-for="(item, index) in menuList"
					:key="item.key"
					:class="{ 'menu-item-last': index === menuList.length - 1 }"
					@click="onItemClick(item)"
				>
					<text class="menu-name">{{ item.name }}</text>
					<view class="arrow"></view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	type MenuItem = {
		key: string
		name: string
	}

	const menuList = ref<MenuItem[]>([
		{ key: 'features', name: '功能介绍' },
		{ key: 'privacy_guide', name: '隐私保护指引' },
		{ key: 'terms', name: '服务条款' },
		{ key: 'opensource', name: '开源许可' },
		{ key: 'system_notice', name: '系统通知' },
		{ key: 'check_update', name: '检查新版本' }
	])

	const goBack = () => {
		uni.navigateBack()
	}

	const onItemClick = (item: MenuItem) => {
		uni.showToast({ title: item.name, icon: 'none' })
	}
</script>

