const sliderPercent = ref<number>(50)

const goBack = () => {
	uni.navigateBack({ delta: 1 })
}

const onTrackClick = (e: any) => {
	// 简化：根据点击区域估算
	uni.showToast({ title: '标准', icon: 'none' })
}
</script>

