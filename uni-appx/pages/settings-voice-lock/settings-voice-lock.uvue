<template>
	<view class="page">
		<!-- 状态栏占位 -->
		<view class="status-bar"></view>

		<!-- 顶部导航 -->
		<view class="nav-bar">
			<view class="back-icon" @click="goBack"></view>
			<text class="nav-title">声音锁</text>
		</view>

		<!-- 内容区 -->
		<scroll-view class="content" scroll-y>
			<view class="desc">声音锁可帮助你在声音验证通过后登录，提高账号安全。</view>

			<view class="record-area">
				<view class="record-circle" @click="onStartRecord">
					<text class="record-circle-text">按住</text>
				</view>
				<text class="hint">请按住说话，朗读数字 8 4 9 2</text>
			</view>

			<view class="wave-bar"></view>

			<view class="button-row">
				<view class="btn btn-outline" @click="onReRecord">
					<text class="btn-text-outline">重录</text>
				</view>
				<view class="btn btn-primary" @click="onNext">
