	</view>
</template>

<script setup lang="uts">
	const goBack = () => {
		uni.navigateBack({ delta: 1 })
	}

	const onStartRecord = () => {
		uni.showToast({ title: '开始录制', icon: 'none' })
	}

	const onReRecord = () => {
		uni.showToast({ title: '重新录制', icon: 'none' })
	}

	const onNext = () => {
		uni.showToast({ title: '下一步', icon: 'none' })
	}
</script>

