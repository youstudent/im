<template>
	<view class="page">
		<!-- 状态栏占位 -->
		<view class="status-bar"></view>

		<!-- 顶部导航 -->
		<view class="nav-bar">
			<view class="back-icon" @click="goBack"></view>
			<text class="nav-title">设置</text>
			<view class="nav-right"></view>
		</view>

		<!-- 内容区 -->
		<scroll-view class="content" scroll-y>
			<view class="menu-groups">
				<view
					class="menu-group"
					v-for="(group, gIndex) in menuGroups"
					:key="gIndex"
				>
					<view
						class="menu-item"
						v-for="(item, index) in group.items"
						:key="item.key"
						:class="{ 'menu-item-last': index === group.items.length - 1 }"
						@click="onItemClick(item)"
					>
						<text class="menu-name">{{ item.name }}</text>
						<view class="arrow"></view>
					</view>
				</view>
			</view>

			<view class="logout-btn" @click="onLogout">
				<text class="logout-text">退出登录</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	type MenuItem = {
		key: string
		name: string
	}

	type MenuGroup = {
		items: MenuItem[]
	}

	const menuGroups = ref<MenuGroup[]>([
		{
			items: [
				{ key: 'account', name: '账号与安全' }
			]
		},
		{
			items: [
				{ key: 'notification', name: '新消息通知' },
				{ key: 'privacy', name: '隐私' },
				{ key: 'general', name: '通用' }
			]
		},
		{
			items: [
				{ key: 'help', name: '帮助与反馈' }
			]
		},
		{
			items: [
				{ key: 'about', name: '关于' }
			]
		}
	])

	const goBack = () => {
		uni.navigateBack()
	}

	const onItemClick = (item: MenuItem) => {
		let url = ''
		switch (item.key) {
			case 'account': url = '/pages/settings-account/settings-account'; break
			case 'notification': url = '/pages/settings-notify/settings-notify'; break
			case 'privacy': url = '/pages/settings-privacy/settings-privacy'; break
			case 'general': url = '/pages/settings-general/settings-general'; break
			case 'help': url = '/pages/settings-help/settings-help'; break
			case 'about': url = '/pages/settings-about/settings-about'; break
		}
		if (url.length > 0) {
			uni.navigateTo({ url })
			return
		}
		uni.showToast({ title: item.name, icon: 'none' })
	}

	const onLogout = () => {
		uni.showModal({
			title: '提示',
			content: '确定要退出登录吗？',
			success: (res) => {
				if (res.confirm) {
					uni.reLaunch({ url: '/pages/login/login' })
				}
			}
		})
	}
</script>

<style>
	.page {
		display: flex;
		flex-direction: column;
		height: 100%;
		background-color: #F5F5F5;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #F8F8F8;
	}

	/* 顶部导航 */
	.nav-bar {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		height: 44px;
		padding: 0 8px;
		background-color: #F8F8F8;
		border-bottom: 1px solid #E5E5E5;
	}

	.back-icon {
		width: 11px;
		height: 11px;
		border-left: 2px solid #333;
		border-bottom: 2px solid #333;
		transform: rotate(45deg);
		margin-left: 8px;
	}

	.nav-title {
		font-size: 17px;
		color: #000;
		font-weight: 600;
	}

	.nav-right {
		width: 32px;
	}

	/* 内容区 */
	.content {
		flex: 1;
		background-color: #F5F5F5;
	}

	.menu-groups {
		background-color: #F5F5F5;
	}

	.menu-group {
		background-color: #FFFFFF;
		margin-bottom: 8px;
	}

	.menu-item {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		height: 50px;
		padding: 0 16px;
		background-color: #FFFFFF;
		border-bottom: 1px solid #E5E5E5;
		box-sizing: border-box;
	}

	.menu-item-last {
		border-bottom: none;
	}

	.menu-name {
		font-size: 16px;
		color: #000;
	}

	.arrow {
		width: 8px;
		height: 8px;
		border-top: 2px solid #C8C8C8;
		border-right: 2px solid #C8C8C8;
		transform: rotate(45deg);
	}

	.logout-btn {
		display: flex;
		justify-content: center;
		align-items: center;
		height: 50px;
		background-color: #FFFFFF;
		margin-top: 8px;
	}

	.logout-text {
		font-size: 16px;
		color: #FF3B30;
	}
</style>
