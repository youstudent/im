<template>
  <view class="page">
    <view class="status-bar"></view>
    <view class="nav-bar">
      <view class="nav-left" @click="goBack">
        <view class="back-icon"></view>
        <text class="nav-left-text">朋友圈</text>
      </view>
      <text class="nav-title">详情</text>
      <view class="nav-right" @click="onMore">
        <text class="more-dots">· · ·</text>
      </view>
    </view>

    <scroll-view class="content" scroll-y>
      <view class="post-block">
        <view class="post-header">
          <view class="avatar">
            <text class="avatar-text">林</text>
          </view>
          <view class="header-info">
            <text class="user-name">林小北</text>
            <view class="meta-row">
              <text class="meta-time">昨天 08:32</text>
              <text class="meta-dot"> </text>
              <text class="meta-device">来自 iPhone 16 Pro</text>
            </view>
          </view>
        </view>

        <text class="post-content">周末上山看云海，四点半起床是值得的。风景真的绝了，推荐大家有机会一定要去一次！</text>

        <view class="photo-row">
          <view
            v-for="(item, index) in photos"
            :key="index"
            class="photo"
            :class="{ 'photo-last': index === photos.length - 1 }"
            :style="{ background: item }"
            @click="onPhoto"
          ></view>
        </view>
      </view>

      <view class="interaction-block">
        <view class="likes-row">
          <view class="like-avatars">
            <view class="like-avatar la-1"></view>
            <view class="like-avatar la-2"></view>
            <view class="like-avatar la-3"></view>
          </view>
          <text class="like-text">
            <text class="heart">♥</text>
            <text class="like-name">张三、李四、王五</text>
            <text class="like-suffix"> 等 28 人赞了</text>
          </text>
        </view>

        <view class="comments-list">
          <view class="comment-item" v-for="(c, idx) in comments" :key="idx" :class="{ 'comment-item-last': idx === comments.length - 1 }">
            <text class="comment-text">
              <text class="comment-name">{{ c.name }}</text>
              <text v-if="c.replyTo" class="comment-reply"> 回复 </text>
              <text v-if="c.replyTo" class="comment-name">@{{ c.replyTo }}</text>
              <text v-if="c.replyTo" class="comment-suffix">：</text>
              <text v-if="!c.replyTo" class="comment-suffix">：</text>
              <text class="comment-content">{{ c.content }}</text>
            </text>
          </view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <view class="input-bar">
      <view class="input-wrap">
        <input
          class="input-field"
          v-model="commentText"
          placeholder="写评论..."
          placeholder-style="color:#B2B2B2;font-size:14px"
          confirm-type="send"
          @confirm="onSend"
        />
      </view>
      <view class="emoji-btn">
        <view class="emoji-circle"></view>
        <view class="emoji-eye e-1"></view>
        <view class="emoji-eye e-2"></view>
        <view class="emoji-mouth"></view>
      </view>
      <text
        class="send-btn"
        :class="{ 'send-btn-active': commentText.length > 0 }"
        @click="onSend"
      >发送</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const commentText = ref('')

type CommentItem = {
  name: string
  replyTo?: string
  content: string
}

const comments: CommentItem[] = [
  { name: '张三', content: '太美了！下次带上我一起' },
  { name: '李四', replyTo: '张三', content: '约好了，下周未走起！' },
  { name: '王五', content: '云海真的绝了，我也去过峨眉山金顶，感觉差不多' },
  { name: '赵六', content: '早起真的不容易，但看到日出的那一刻一切都值得' }
]

const photos: string[] = [
  'linear-gradient(135deg, #FFB347 0%, #FF8C42 50%, #4A5568 100%)',
  'linear-gradient(135deg, #4A5568 0%, #2D3748 50%, #FF6B35 100%)',
  'linear-gradient(135deg, #9AE6B4 0%, #68D391 50%, #2F855A 100%)'
]

const goBack = (): void => {
  uni.navigateBack({ delta: 1 })
}

	const onMore = (): void => {
	  uni.showActionSheet({
	    itemList: ['收藏', '分享', '复制', '举报'],
	    success: (res) => {
	      uni.showToast({ title: '已选择：' + (res.tapIndex + 1), icon: 'none' })
	    }
	  })
	}

const onPhoto = (): void => {
  uni.previewImage({
    urls: ['', '', ''],
    current: 0
  })
}

const onSend = (): void => {
  if (commentText.value.trim().length === 0) {
    uni.showToast({ title: '请输入评论内容', icon: 'none' })
    return
  }
  uni.showToast({ title: '评论已发表', icon: 'success' })
  commentText.value = ''
}
</script>

