<template>
	<view class="page">
		<!-- 状态栏占位 -->
		<view class="status-bar"></view>

		<!-- 顶部搜索栏 -->
		<view class="search-header">
			<view class="search-box">
				<view class="search-icon">
					<view class="i1"></view>
				</view>
				<input
					class="search-input"
					type="text"
					v-model="keyword"
					placeholder="搜索"
					placeholder-class="search-placeholder"
					focus
					@confirm="onSearch"
				/>
			</view>
			<text class="cancel-text" @click="goBack">取消</text>
		</view>

		<!-- 搜索结果 -->
		<scroll-view class="result-scroll" scroll-y>
			<view class="result-list">
				<text class="section-title">聊天记录</text>

				<view
					class="result-item"
					v-for="(item, index) in resultList"
					:key="item.id"
					:class="{ 'result-item-last': index === resultList.length - 1 }"
					@click="onItemClick(item)"
				>
					<view class="avatar" :style="{ backgroundColor: item.avatarColor }">
						<text class="avatar-text">{{ item.avatarText }}</text>
					</view>
					<view class="result-content">
						<text class="result-name">{{ item.name }}</text>
						<text class="result-message">{{ item.message }}</text>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'

	type ResultItem = {
		id: string
		name: string
		avatarText: string
		avatarColor: string
		message: string
	}

	const keyword = ref<string>('')

	const resultList = ref<ResultItem[]>([
		{
			id: '1',
			name: '林晚',
			avatarText: '林',
			avatarColor: '#07C160',
			message: '周末的方案评审会议改到下午三点'
		},
		{
			id: '2',
			name: '产品交流群',
			avatarText: '群',
			avatarColor: '#999999',
			message: '关于新方案的排版细节需要再确认一下'
		},
		{
			id: '3',
			name: '文件传输助手',
			avatarText: '文',
			avatarColor: '#5B6BFF',
			message: '方案终稿_v3.pdf 已经发送给你了'
		}
	])

	const goBack = () => {
		uni.navigateBack()
	}

	const onSearch = () => {
		uni.showToast({ title: `搜索：${keyword.value}`, icon: 'none' })
	}

	const onItemClick = (item: ResultItem) => {
		uni.showToast({ title: item.name, icon: 'none' })
	}
</script>

