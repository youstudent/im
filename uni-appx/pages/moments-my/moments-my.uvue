<template>
  <view class="page">
    <view class="status-bar"></view>
    <view class="nav-bar">
      <view class="nav-icon camera-icon" @click="onCamera">
        <view class="cam-body"></view>
        <view class="cam-top"></view>
        <view class="cam-lens"></view>
        <view class="cam-flash"></view>
      </view>
      <text class="nav-title">我的朋友圈</text>
      <view class="nav-icon clock-icon" @click="onClock">
        <view class="clock-circle"></view>
        <view class="clock-hand hh"></view>
        <view class="clock-hand mh"></view>
        <view class="clock-dot"></view>
        <view class="clock-arrow-back"></view>
      </view>
    </view>

    <scroll-view class="content" scroll-y>
      <view
        v-for="(item, idx) in moments"
        :key="idx"
        class="moment-card"
        @click="onMoment(item.id)"
      >
        <view class="moment-header">
          <view
            class="avatar"
            :style="{ background: item.avatarBg }"
          >
            <text class="avatar-text">{{ item.avatarChar }}</text>
          </view>
          <view class="header-info">
            <text class="user-name">{{ item.name }}</text>
            <text class="moment-text">{{ item.text }}</text>
            <view v-if="item.photos.length > 0" class="photo-list">
              <view
                v-for="(p, pi) in item.photos"
                :key="pi"
                class="photo"
                :class="{ 'photo-last-row': (pi + 1) % 2 === 0, 'photo-last': isLastPhoto(item.photos, pi) }"
                :style="{ background: p }"
                @click.stop="onPhoto"
              ></view>
            </view>
            <view v-if="item.link" class="link-card" @click.stop="onLink">
              <view class="link-thumb"></view>
              <text class="link-text">{{ item.link }}</text>
            </view>
            <text class="moment-time">{{ item.time }}</text>
          </view>
        </view>
      </view>

      <view class="footer-tips">
        <text class="footer-text">仅展示最近半年的朋友圈</text>
      </view>
      <view class="bottom-space"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
type MomentItem = {
  id: number
  name: string
  avatarBg: string
  avatarChar: string
  text: string
  photos: string[]
  link?: string
  time: string
}

const moments: MomentItem[] = [
  {
    id: 1,
    name: '林小北',
    avatarBg: '#FF9500',
    avatarChar: '林',
    text: '周末上山看云海，四点半起床是值得的。风景真的绝了，推荐大家有机会一定要去一次！',
    photos: [
      'linear-gradient(135deg, #FFB347 0%, #FF8C42 50%, #4A5568 100%)',
      'linear-gradient(135deg, #4A5568 0%, #2D3748 50%, #FF6B35 100%)',
      'linear-gradient(135deg, #9AE6B4 0%, #68D391 50%, #2F855A 100%)'
    ],
    time: '昨天 08:32'
  },
  {
    id: 2,
    name: '林小北',
    avatarBg: '#FF9500',
    avatarChar: '林',
    text: '新做的手冲，豆子换成了日晒，酸度刚好。',
    photos: [
      'linear-gradient(135deg, #6B4423 0%, #8B5A2B 50%, #3E2723 100%)'
    ],
    time: '2 天前'
  },
  {
    id: 3,
    name: '林小北',
    avatarBg: '#FF9500',
    avatarChar: '林',
    text: '这篇讲设计规范的文章写得很清楚，推荐一读。',
    photos: [],
    link: '如何搭建一套可落地的设计规范',
    time: '3 天前'
  }
]

const goBack = (): void => {
  uni.navigateBack({ delta: 1 })
}

const onCamera = (): void => {
  uni.showToast({ title: '打开相机', icon: 'none' })
}

const onClock = (): void => {
  uni.showToast({ title: '查看历史', icon: 'none' })
}

const onPhoto = (): void => {
  uni.showToast({ title: '查看照片', icon: 'none' })
}

const isLastPhoto = (photos: string[], index: number): boolean => {
  return index === photos.length - 1
}

const onLink = (): void => {
  uni.showToast({ title: '打开文章', icon: 'none' })
}

const onMoment = (id: number): void => {
  uni.navigateTo({ url: '/pages/moment-detail/moment-detail' })
}
</script>

