<template>
	<view class="voip-page">
		<!-- 状态栏占位 -->
		<view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>

		<!-- 顶部信息栏 -->
		<view class="top-bar">
			<view class="caller-info">
				<text class="caller-name">{{ nickname }}</text>
				<text class="call-timer">{{ displayTime }}</text>
			</view>
			<!-- 视频预览区域（视频通话时显示对方画面/小窗） -->
			<view class="video-preview">
				<view class="preview-placeholder"></view>
			</view>
		</view>

		<!-- 中间空白区（视频画面主区域） -->
		<view class="video-area">
			<!-- 视频通话主画面占位 -->
		</view>

		<!-- 底部操作栏 -->
		<view class="bottom-actions">
			<view class="action-item" @click="onMute">
				<view class="action-circle" :class="{ active: isMuted }">
					<view class="icon-mute">
						<view class="i1"></view>
						<view class="i2"></view>
					</view>
				</view>
				<text class="action-label">静音</text>
			</view>
			<view class="action-item" @click="onSpeaker">
				<view class="action-circle" :class="{ active: isSpeakerOn }">
					<view class="icon-speaker">
						<view class="i1"></view>
						<view class="i2"></view>
					</view>
				</view>
				<text class="action-label">扬声器</text>
			</view>
			<view class="action-item" @click="onCameraToggle">
				<view class="action-circle" :class="{ active: !isCameraOn }">
					<view class="icon-camera">
						<view class="i1"></view>
						<view class="i2"></view>
					</view>
				</view>
				<text class="action-label">摄像头</text>
			</view>
			<view class="action-item" @click="onHangup">
				<view class="hangup-circle">
					<view class="hangup-icon">
						<view class="i1"></view>
						<view class="i2"></view>
					</view>
				</view>
				<text class="action-label">挂断</text>
			</view>
		</view>

		<!-- 最小化提示 -->
		<view class="minimize-hint" @click="onMinimize">
			<text class="minimize-text">下滑最小化</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, onMounted, computed } from 'vue'

	const statusBarHeight = ref<number>(44)
	const nickname = ref<string>('林晚')
	const callSeconds = ref<number>(12) // 模拟通话秒数

	const isMuted = ref<boolean>(false)
	const isSpeakerOn = ref<boolean>(false)
	const isCameraOn = ref<boolean>(true)

	// 格式化显示时间 MM:SS
	const displayTime = computed<string>(() : string => {
		const m = Math.floor(callSeconds.value / 60)
		const s = callSeconds.value % 60
		const mStr = m < 10 ? '0' + m.toString() : m.toString()
		const sStr = s < 10 ? '0' + s.toString() : s.toString()
		return mStr + ':' + sStr
	})

	onMounted(() => {
		try {
			const info = uni.getSystemInfoSync()
			statusBarHeight.value = info.statusBarHeight || 44
		} catch (e) {}

		// 读取页面参数
		const pages = getCurrentPages()
		if (pages.length > 0) {
			const curPage = pages[pages.length - 1] as UniPage
			const options = curPage.options
			const name = options['name']
			if (name != null) {
				nickname.value = name as string
			}
		}
	})

	const onMute = () => {
		isMuted.value = !isMuted.value
		uni.showToast({ title: isMuted.value ? '已静音' : '已取消静音', icon: 'none' })
	}

	const onSpeaker = () => {
		isSpeakerOn.value = !isSpeakerOn.value
		uni.showToast({ title: isSpeakerOn.value ? '扬声器开启' : '扬声器关闭', icon: 'none' })
	}

	const onCameraToggle = () => {
		isCameraOn.value = !isCameraOn.value
		uni.showToast({ title: isCameraOn.value ? '摄像头开启' : '摄像头关闭', icon: 'none' })
	}

	const onHangup = () => {
		uni.redirectTo({ url: '/pages/voip-ended/voip-ended?name=' + nickname.value + '&duration=' + callSeconds.value.toString() })
	}

	const onMinimize = () => {
		uni.showToast({ title: '最小化', icon: 'none' })
	}
</script>

<style scoped>
	.voip-page {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: #000000;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		width: 100%;
		background-color: #000000;
	}

	.top-bar {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		justify-content: space-between;
		padding: 16px 20px 0 20px;
	}

	.caller-info {
		display: flex;
		flex-direction: column;
	}

	.caller-name {
		font-size: 18px;
		color: #FFFFFF;
		font-weight: 500;
	}

	.call-timer {
		font-size: 14px;
		color: #CCCCCC;
		margin-top: 4px;
	}

	.video-preview {
		width: 100px;
		height: 134px;
		border-radius: 12px;
		overflow: hidden;
		background-color: #1A1A1A;
	}

	.preview-placeholder {
		width: 100%;
		height: 100%;
		background-color: #2C2C2C;
		border-radius: 12px;
	}

	.video-area {
		flex: 1;
		background-color: #0A0A0A;
	}

	.bottom-actions {
		display: flex;
		flex-direction: row;
		justify-content: space-around;
		align-items: center;
		padding: 20px 16px 30px 16px;
		background-color: #1A1A1A;
	}

	.action-item {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.action-circle {
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background-color: #3A3A3A;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
	}

	.action-circle.active {
		background-color: #FA5151;
	}

	.hangup-circle {
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background-color: #FA5151;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
	}

	.action-label {
		font-size: 11px;
		color: #FFFFFF;
		margin-top: 8px;
	}

	/* 静音图标：麦克风带斜线 */
	.icon-mute {
		width: 18px;
		height: 22px;
		position: relative;
	}

	.icon-mute .i1 {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 10px;
		height: 14px;
		background-color: #FFFFFF;
		border-radius: 5px 5px 2px 2px;
	}

	.icon-mute .i2 {
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 16px;
		height: 8px;
		border-left: 2px solid #FFFFFF;
		border-right: 2px solid #FFFFFF;
		border-bottom: 2px solid #FFFFFF;
		border-radius: 0 0 8px 8px;
		box-sizing: border-box;
	}

	/* 扬声器图标 */
	.icon-speaker {
		width: 18px;
		height: 16px;
		position: relative;
	}

	.icon-speaker .i1 {
		position: absolute;
		left: 0;
		bottom: 2px;
		width: 8px;
		height: 10px;
		background-color: #FFFFFF;
		border-radius: 1px;
	}

	.icon-speaker .i2 {
		position: absolute;
		right: 0;
		bottom: 3px;
		width: 0;
		height: 0;
		border-left: 8px solid #FFFFFF;
		border-top: 5px solid transparent;
		border-bottom: 5px solid transparent;
	}

	/* 摄像头图标 */
	.icon-camera {
		width: 20px;
		height: 16px;
		position: relative;
	}

	.icon-camera .i1 {
		position: absolute;
		left: 0;
		top: 2px;
		width: 18px;
		height: 12px;
		border: 2px solid #FFFFFF;
		border-radius: 3px;
		box-sizing: border-box;
	}

	.icon-camera .i2 {
		position: absolute;
		right: 2px;
		top: 5px;
		width: 6px;
		height: 6px;
		background-color: #FFFFFF;
		border-radius: 50%;
	}

	/* 挂断图标：电话听筒 */
	.hangup-icon {
		width: 22px;
		height: 22px;
		position: relative;
	}

	.hangup-icon .i1 {
		position: absolute;
		top: 6px;
		left: 3px;
		width: 16px;
		height: 10px;
		border: 2.5px solid #FFFFFF;
		border-top: none;
		border-radius: 0 0 8px 8px;
		transform: rotate(-45deg);
		box-sizing: border-box;
	}

	.hangup-icon .i2 {
		position: absolute;
		top: 6px;
		right: 3px;
		width: 16px;
		height: 10px;
		border: 2.5px solid #FFFFFF;
		border-top: none;
		border-radius: 0 0 8px 8px;
		transform: rotate(45deg);
		box-sizing: border-box;
	}

	.minimize-hint {
		padding: 8px 0 16px 0;
		display: flex;
		justify-content: center;
		background-color: #1A1A1A;
	}

	.minimize-text {
		font-size: 12px;
		color: #888888;
	}
</style>
